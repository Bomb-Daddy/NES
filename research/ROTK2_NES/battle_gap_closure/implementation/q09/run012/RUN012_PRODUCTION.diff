+def q09_escape_score(movement:int, war:int, training:int, troops100:int,
+                     opposing_neighbors:int, is_ruler:bool, special_a3:bool,
+                     roll10:int)->int:
+    """Original hsovl2 $D5E9–$D62D score, source-state inputs explicit.
+
+    Rolls are supplied rather than generated so original-emulator fixtures can
+    assert exact intermediate score and test both comparison boundaries.
+    `troops100` is the original battle-scale troop word (not men rounded by UI).
+    """
+    values=(movement,war,training,troops100,opposing_neighbors,roll10)
+    if (any(type(v) is not int for v in values) or
+        movement<0 or war<0 or training<0 or troops100<0 or
+        not 0<=opposing_neighbors<=6 or not 0<=roll10<10 or
+        type(is_ruler) is not bool or type(special_a3) is not bool):
+        raise ValueError('INVALID_Q09_ESCAPE_SCORE_INPUT')
+    base=(10*movement+war+training+troops100//100)//(opposing_neighbors+2)
+    return min(100,base+(20 if is_ruler else 0)+(20 if special_a3 else 0)+roll10)
+
