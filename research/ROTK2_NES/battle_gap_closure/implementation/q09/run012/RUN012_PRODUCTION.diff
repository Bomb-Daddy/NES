+def q09_escape_check(state:GameState,b:Battle,u:BattleUnit)->bool:
+    """Execute hsovl2 $D582 source check only with required original bytes.
+
+    A verified +2 flag $40 immediately succeeds WITHOUT an RNG draw.
+    Otherwise both source bytes must be known. Unknown/legacy campaign inputs
+    retain the old successful-escape path (an explicitly OPEN parity gap).
+    The deterministic portable RNG is a harness, not a claim about NES timing.
+    """
+    flag,special,movement11=_q09_source_fields(state,u)
+    if flag is not None and flag&0x40:
+        b.log.append(f'd{b.day} Q09 officer {u.officer_id} source flag40 escape')
+        return True
+    if flag is None or special is None or movement11 is None:
+        return True  # UNKNOWN SOURCE STATE: preserve migration/legacy behavior
+    officer=state.officers[u.officer_id]
+    # Original native $BFBB raises ordinary movement byte to the trained floor.
+    # Exact 8-bit signed subtraction behavior for arbitrary injected high bytes
+    # is a distinct source-execution fixture still outstanding.
