+        (special is not None and (type(special) is not int or not 0<=special<=255)) or
+        (movement is not None and (type(movement) is not int or not 0<=movement<=255))):
+        raise ValueError('INVALID_Q09_SOURCE_BYTES')
+    return flag,special,movement
