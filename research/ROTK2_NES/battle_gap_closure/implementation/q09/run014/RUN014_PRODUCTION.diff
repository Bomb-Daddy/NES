+def _q09_apply_immediate_source_flee(state:GameState,b:Battle,u:BattleUnit,
+                                     destination:int)->None:
+    """Source $D648/$D6A5: insert a *known* escaped officer immediately.
+
+    Only individual Flee into a peaceful province is modeled here. Native
+    root $5154 moves the officer before battle termination; root $507C also
+    claims a previously open province, and $D69A divides battle troops by
+    100 for an un-attacked destination. Ruler insertion promotes the head.
+
+    Under-attack destinations retain a battle-scale officer word in the
+    original; this port still lacks the distinct strategic/battle resident
+    representation. Do NOT fabricate a scaled strategic troop count there.
+    This helper is never invoked on source-unknown or failed-escape paths.
+    """
+    target=state.provinces[destination]
+    officer=state.officers[u.officer_id]
+    if target.under_attack:
+        b.log.append(f'd{b.day} Q09 officer {u.officer_id} active-siege ' 
+                     'source insertion UNMODELLED')
+        return
+    old=officer.province_id
+    # If this officer was the explicitly recovered old head, its successor
+    # is not known: clear the stale snapshot rather than invent list order.
+    if old in state.provinces and state.provinces[old].q09_officer_head==officer.id:
+        state.provinces[old].q09_officer_head=None
+    empty=(target.owner is None or
+           not any(o.alive and o.province_id==destination and
+                   o.ruler_id==officer.ruler_id for o in state.officers.values()))
+    if target.owner is None and officer.ruler_id in state.rulers:
+        target.owner=officer.ruler_id
+    officer.province_id=destination
+    officer.soldiers=(u.troops100 if u.troops100 is not None else u.soldiers*100)//100
+    if officer.is_ruler or empty:
+        target.q09_officer_head=officer.id
+    if (officer.is_ruler and officer.ruler_id in state.rulers
+            and target.owner==officer.ruler_id):
+        state.rulers[officer.ruler_id].q14_owned_head=destination
+
+
