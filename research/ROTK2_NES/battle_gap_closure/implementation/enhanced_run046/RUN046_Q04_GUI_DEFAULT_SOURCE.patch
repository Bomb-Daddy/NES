+def _activate_original_q04_gui(campaign):
+    """Use the English NES's human Q04 deployment in live 41-province GUI play.
+
+    Historical/synthetic core-test campaigns retain their explicit opt-in.
+    An already running battle is never converted into a new staging phase.
+    The source-region/cell validation remains in q04_manual_deployment.py.
+    """
+    state=campaign.state
+    if len(state.get('owners',()))!=41 or state.get('battle') is not None:
+        return False
+    if state.get('q04_manual_deployment') is True:
+        return False
+    state['q04_manual_deployment']=True
+    return True
+
