 def _all(b,side):
     return [u for u in b['officer_units'] if u['side']==side and u['troops100']>=100 and not u['fled'] and not u.get('reserve')]
+
+
+def _q03_resident_defenders_troops100(s, b):
+    """Q03: stationed defender officers not represented in a field/queue list.
+
+    The roster is authoritative: only actual living officers posted at the
+    contested defender province and owning real stationed army groups count.
+    No phantom reserve group or duplicated deployed troop is introduced.
+    """
+    # Legacy aggregate battles do not distinguish a resident roster; counting
+    # all posted officers there would double-charge the displayed army.
+    if not b.get('officer_units'):
+        return 0
+    listed={u['id'] for u in b['officer_units']
+            if u['side']=='D' and not u.get('fled')}
+    total=0
+    for army in s['armies'].values():
+        oid=army['commander']
+        officer=s['core']['officers'].get(oid)
+        if (oid in listed or officer is None
+            or s['officer_faction'].get(oid)!=b['defender']
+            or officer['province_id']!=b['dst']):
+            continue
+        total+=100*army['stations'].get(b['dst'],0)
+    return total
 
 
