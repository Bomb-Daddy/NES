+def is_live_list_head(b,u):
+    """Q10 hsovl1 D5DD/$7AC0: head is the *current* list's first live unit.
+
+    The old `commander` bool describes the original commander at deployment.
+    It is not reassigned when that officer leaves the field. Source Q10 tests
+    the linked-list head itself, so surviving noncommanders can become heads.
+    The order of b['officer_units'] is the port's stored list order; historical
+    four-slot *scheduling* remains separately unverified.
+    """
+    for candidate in b.get('officer_units',()):
+        if (candidate.get('side')==u.get('side') and
+                candidate.get('slot')==u.get('slot') and
+                candidate.get('troops100',0)>=100 and
+                not candidate.get('fled') and not candidate.get('reserve')):
+            return candidate is u or candidate.get('id')==u.get('id')
+    return False
+
+
 def _all(b,side):
     return [u for u in b['officer_units'] if u['side']==side and u['troops100']>=100 and not u['fled'] and not u.get('reserve')]
 
