+    def _visible_officer_at(self,q,r):
+        """Q15 original tactical View has no fog or friendly-side restriction.
+
+        Lookup always uses the CURRENT battle officer roster, not selected
+        player's unit/Next Target or a queued reserve. This is view-only.
+        """
+        b=self.parent.c.state.get('battle')
+        if not b:return None
+        return next((u for u in b.get('officer_units',())
+                     if (u['q'],u['r'])==(q,r) and u['troops100']>=100
+                     and not u.get('reserve') and not u.get('fled')),None)
+
+    def _officer_view_text(self,u):
+        # Report the fields actually present in the campaign. "Arm" is the
+        # stored equipped-men quantity; do not invent a ratio or historical
+        # stat byte. Original English NES pixel/text match stays OPEN.
+        arms=self.parent.c.state.get('unit_armed_men',{}).get(u['id'])
+        armtext=str(arms) if isinstance(arms,int) else '?'
+        return (f'Officer {u["id"]}  Skill {u["training"]}  Arm {armtext}  '
+                f'Int {u["intel"]}  War {u["war"]}  Troops {u["troops"]}')
+
+    def start_view_officer(self):
+        b=self.parent.c.state.get('battle')
+        if not b or not b.get('officer_units'):
+            self.message.set('No battle officer available to inspect')
+            self.redraw();return
+        officer=next((u for u in b['officer_units']
+                      if u['id']==self.selected_officer and u['troops100']>=100
+                      and not u.get('fled') and not u.get('reserve')),None)
+        if officer is None:
+            officer=next((u for u in b['officer_units']
+                          if u['troops100']>=100 and not u.get('fled')
+                          and not u.get('reserve')),None)
+        if officer is None:
+            self.message.set('No battle officer available to inspect')
+            self.redraw();return
+        self.view_officer_id=None
+        self.targeting=True
+        self.target_mode='battle_view_officer'
+        self.target_actor=None;self.target_phase=None
+        self.target_enemy=None;self.target_enemy_hex=None
+        self.target_q,self.target_r=officer['q'],officer['r']
+        self.message.set('View Officer: D-pad points to any visible unit; A view, B cancel')
+        self.redraw()
 
