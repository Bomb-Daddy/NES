diff --git a/README_EXEC0177.md b/README_EXEC0177.md
new file mode 100644
index 0000000..583123a
--- /dev/null
+++ b/README_EXEC0177.md
@@ -0,0 +1,38 @@
+# EXEC0177 — Authenticated Enhanced continuation replay save and cold resume
+
+This is a **real incremental save/cold-load improvement to the SAME 1280x720
+native C11 game**, based on all files in EXEC0176. It does **not** implement
+KOEI/NES first-Spring setup, AI, three Classic commands, original trade RNG,
+dynasty, diplomacy, battle aftermath, a full campaign, or Win32 device QA.
+
+Controller X while the Enhanced continuation is active creates an exclusive,
+owner-private `.gk77` receipt. Y loads it without changing live state on
+failure. From TITLE, X loads the exact private original `.gk17` source and
+then the newest continuation `.gk77`, checking the complete immutable original
+checkpoint and replaying all 5 inherited and up to 20 continuation seasons.
+A corrupted newer receipt refuses rather than silently rolling back to an
+older stage. No source ROM bytes, SRAM, images or audio go into `.gk77`.
+
+The fixed 448-byte GC77/v1 format records the source SHA identity and ordered
+from/to/amount action receipts, Pass flags and current season; trailing SHA256
+validates file integrity but is **not** authentication. The actual authenticity
+boundary is the SHA-validated private original source, complete upstream
+stage replay, strict canonical re-encode and atomic commit. Classic mode
+cannot import Enhanced receipts. Existing `.gk16`–`.gk21` receipts are retained.
+
+Linux I/O: exclusive 0600 creation, file fsync, parent-directory fsync,
+O_NOFOLLOW load, fstat regular/owner-only/single-link/exact-size checks.
+Windows `_commit` branch authored but **NOT RUN** and Windows ACL equivalence
+not certified. Only the verified `.gk77` ownership path is allowed to consume
+this format, never the original NES source slot.
+
+Build: `cmake -S execution_177 -B build177 -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build177 -j8 && ctest --test-dir build177 --output-on-failure`.
+Private original runtime regression (do not publish fixtures):
+`build177/test_gk177_enhanced_receipt build177/GK1_ALL_41_COUNTRY_ECONOMIC_DATA_v1.07.csv PRIVATE_FRESH_14x83.bin 1`;
+use profile 2 for archived Mongol SaveRAM, profile 3 for archived World SaveRAM.
+
+Labels: VERIFIED_STATIC (source/replay/format); OBSERVED_RUNTIME_STOCK (prior
+three original Spring samples only); TESTED_PORT_LINUX (native integration
+and controller UI). NOT RUN: new NES/Mesen playback, Windows installer,
+physical Xbox, full campaigns. Publication of this source is not a Director
+acceptance or other agent execution acknowledgement.
diff --git a/gk177_enhanced_receipt.c b/gk177_enhanced_receipt.c
new file mode 100644
index 0000000..9f9f99c
--- /dev/null
+++ b/gk177_enhanced_receipt.c
@@ -0,0 +1,194 @@
+#define _GNU_SOURCE
+#include "gk177_enhanced_receipt.h"
+#include "gk1_source_identity.h"
+#include <string.h>
+#include <stdio.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <unistd.h>
+#include <fcntl.h>
+#endif
+
+#define BASE 48u
+#define FIRST_SEASONS 5u
+#define RECORD 14u
+#define CONT (BASE + FIRST_SEASONS*RECORD)
+#define HASH 416u
+static uint16_t amount(const uint8_t *s){return (uint16_t)((unsigned)s[2]|((unsigned)s[3]<<8));}
+static void put(uint8_t *p,uint8_t n,uint8_t passed,const Gk116LaborAction *a){
+ p[0]=n;p[1]=passed;
+ for(unsigned i=0;i<n;i++){
+  p[2u+i*4u]=a[i].from;p[3u+i*4u]=a[i].to;
+  p[4u+i*4u]=(uint8_t)a[i].quantity;
+  p[5u+i*4u]=(uint8_t)(a[i].quantity>>8);
+ }
+}
+static int canonical_stages(const Gk79Checkpoint *o,const Gk177Stages *s){
+ return o&&s&&gk176_attestation_intact(&s->continuation,
+   &s->year2,&s->spring,&s->summer,&s->fall,&s->winter,o);
+}
+Gk177Status gk177_encode(const Gk79Checkpoint *o,const Gk177Stages *s,
+ uint8_t raw[GK177_BYTES]){
+ if(!raw||!o||!s)return GK177_INPUT;
+ if(!canonical_stages(o,s))return GK177_SOURCE;
+ memset(raw,0,GK177_BYTES);
+ memcpy(raw,"GC77",4);raw[4]=1u;raw[5]=1u;
+ raw[6]=(uint8_t)s->spring.mutable_world.scenario_id;
+ raw[7]=s->spring.player_index;
+ raw[8]=(uint8_t)s->spring.year;raw[9]=(uint8_t)(s->spring.year>>8);
+ raw[10]=(uint8_t)s->spring.rate;raw[11]=(uint8_t)(s->spring.rate>>8);
+ raw[12]=s->continuation.season_index;raw[13]=1u;
+ memcpy(raw+16,s->spring.source_sha,32);
+ put(raw+BASE,s->spring.action_count,s->spring.pass_ended,s->spring.actions);
+ put(raw+BASE+RECORD,s->summer.action_count,s->summer.pass_ended,s->summer.actions);
+ put(raw+BASE+2u*RECORD,s->fall.action_count,s->fall.pass_ended,s->fall.actions);
+ put(raw+BASE+3u*RECORD,s->winter.action_count,s->winter.pass_ended,s->winter.actions);
+ put(raw+BASE+4u*RECORD,s->year2.action_count,s->year2.pass_ended,s->year2.actions);
+ for(unsigned i=0;i<=s->continuation.season_index;i++){
+  const Gk176SeasonReceipt *r=&s->continuation.receipts[i];
+  put(raw+CONT+i*RECORD,r->action_count,r->pass_ended,r->actions);
+ }
+ gk1_sha256_bytes(raw,HASH,raw+HASH);
+ return GK177_OK;
+}
+static int valid_rec(const uint8_t *p){return p[0]<=3u&&p[1]<=1u;}
+#define ACT(P) ((P)+2u)
+#define LOOP_TRANSFER(R,OBJ,CALL) do{ \
+ const uint8_t *r=(R);if(!valid_rec(r))return GK177_CORRUPT; \
+ for(unsigned j=0;j<r[0];j++){const uint8_t *a=ACT(r)+4u*j; \
+  if((CALL)!=GK177_OK)return GK177_CORRUPT;} \
+}while(0)
+/* Replay every preserved stage against the authenticated original source.
+ * Do not deserialize mutable world state, budgets, RNG or licensed source. */
+Gk177Status gk177_decode(const Gk79Checkpoint *o,uint8_t enhanced,
+ const uint8_t *raw,size_t length,Gk177Stages *out){
+ if(!o||!raw||!out)return GK177_INPUT;
+ if(enhanced!=1u)return GK177_SOURCE;
+ if(length!=GK177_BYTES||memcmp(raw,"GC77",4)||raw[4]!=1u||
