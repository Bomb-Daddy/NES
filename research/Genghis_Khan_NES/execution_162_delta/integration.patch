index 0000000..0abb784
--- /dev/null
+++ b/README_EXEC0162.md
@@ -0,0 +1,26 @@
+# GK1 EXEC0162 — Original-stock checkpoint controller entry, fail-closed source replacement
+
+A new `gk162_enter_original_checkpoint` source-authenticated attachment boundary is
+connected to the **existing** native controller `A` action in the Spring Archive.
+It requires canonical owner-supplied CSV and a SHA-verified 14×83 or 27×83
+actual ORIGINAL stock RAM export, preserves both PRE_SETUP template worlds,
+opens the correct original-season country menu with 3 **available** orders, and
+invalidates all prior Enhanced-derived labor stages **including Year2**.
+Source errors and incorrect WorkRAM/SaveRAM profile selections are transactional
+and leave the entire app unchanged. The player's explicit Classic vs Enhanced
+preference survives attachment; Classic commands VIEW and PASS are controller
+accessible, including B-cancel and a source-bound PASS receipt with cold-load.
+
+This implementation is **not** a source-independent NES first-Spring
+initialization. It does not implement all three original NES actions or generate
+NES original character, difficulty or merchant RNG, run AI, or transition the
+original season. No RAM/ROM/checkpoint bytes are in public code or installer.
+
+`test_gk162_original_entry <source-csv> [<fresh-original-14x83> <restored-original-14x83> <restored-world-27x83>]`
+
+`VERIFIED_STATIC`: code, source gates and original hash checks.
+`OBSERVED_RUNTIME_STOCK`: inherited 2026-11-07 fresh WorkRAM and archived
+SaveRAM observations, no newly executed Mesen original NES.
+`TESTED_PORT_LINUX`: actual build, tests, native graphics and Debian QA when
+independently executed and recorded.
+`NOT RUN`: Windows Win32, NSIS installer, physical Xbox, whole campaigns.
diff --git a/gk162_original_entry.c b/gk162_original_entry.c
new file mode 100644
index 0000000..c185b73
--- /dev/null
+++ b/gk162_original_entry.c
@@ -0,0 +1,53 @@
+#include "gk162_original_entry.h"
+#include "gk117_stock_pristine_gate.h"
+#include <stdlib.h>
+#include <string.h>
+
+Gk162EntryStatus gk162_enter_original_checkpoint(Gk1App *a,
+ const char *csv,const char *records,Gk77Profile profile,uint8_t player){
+ if(!a||!csv||!*csv||!records||!*records||
+    (profile!=GK77_FRESH_MONGOL_WORKRAM&&
+     profile!=GK77_ARCHIVED_MONGOL_SAVERAM&&
+     profile!=GK77_ARCHIVED_WORLD_SAVERAM))return GK162_ENTRY_ARGUMENT;
+ unsigned w=profile==GK77_ARCHIVED_WORLD_SAVERAM?1u:0u;
+ if(a->rules_profile>1u||!a->world_ready[w]||
+    a->worlds[w].phase!=GK1_PRE_SETUP_TEMPLATE||
+    a->worlds[w].scenario_id!=(w?GK1_WORLD_CONQUEST:GK1_MONGOL_CONQUEST)||
+    a->worlds[w].country_count!=(w?27u:14u))return GK162_ENTRY_TEMPLATE;
+ /* Production source gate does all identity, SHA, and source-projection checks
+  * into a separate candidate; this function cannot mint a playable source. */
+ Gk79Checkpoint *candidate=malloc(sizeof *candidate);
+ if(!candidate)return GK162_ENTRY_SOURCE;
+ Gk117Status ok=gk117_open_attested_original(csv,&a->worlds[w],
+   records,profile,player,candidate);
+ if(ok!=GK117_OK){free(candidate);
+  return ok==GK117_TEMPLATE_DRIFT?GK162_ENTRY_TEMPLATE:GK162_ENTRY_SOURCE;
+ }
+ if(candidate->orders.remaining!=3u||candidate->orders.season!=GK71_SPRING||
+    candidate->year!=(w?1206u:1175u)||!gk85_raw_source_intact(candidate)||
+    !gk88_stock_projection_intact(candidate)){
+   free(candidate);return GK162_ENTRY_SOURCE;
+ }
+ a->stock_checkpoint=*candidate;free(candidate);
+ /* A source profile switch must not leave any Enhanced rollover chain active:
+  * new original checkpoints have different SHA/bank/years and cannot inherit
+  * Enhanced receipts or workers from the previous profile. */
+ memset(&a->enhanced_assign,0,sizeof a->enhanced_assign);
+ memset(&a->enhanced_summer,0,sizeof a->enhanced_summer);
+ memset(&a->enhanced_fall,0,sizeof a->enhanced_fall);
+ memset(&a->enhanced_winter,0,sizeof a->enhanced_winter);
+ memset(&a->enhanced_year2,0,sizeof a->enhanced_year2);
+ a->active_world=(uint8_t)w;
+ a->spring_stock_mode=1u;
+ a->spring_stock_count=a->stock_checkpoint.world.country_count;
+ a->spring_archive_cursor=player;
+ a->spring_preview_mode=0u;
+ a->stock_trade_merchant=0u;a->stock_trade_item=0u;a->stock_trade_sell=0u;
+ a->stock_reconcile_view=0u;
+ a->stock_command_cursor=0u;
+ a->stock_checkpoint.pending_pass=0u;
+ a->stock_checkpoint.raw_view=0u;
+ a->screen=GK1_SCREEN_STOCK_CONTINUE;
+ strcpy(a->status,"ORIGINAL STOCK CHECKPOINT RESTORED; VIEW/PASS ONLY; NO NEW NES SETUP");
+ return GK162_ENTRY_OK;
+}
diff --git a/gk162_original_entry.h b/gk162_original_entry.h
new file mode 100644
index 0000000..29f6485
--- /dev/null
+++ b/gk162_original_entry.h
@@ -0,0 +1,25 @@
+#ifndef GK162_ORIGINAL_ENTRY_H
+#define GK162_ORIGINAL_ENTRY_H
+#include "gk1_app_state.h"
+/* Original-stock SOURCE-CHECKPOINT continuation, not a new original NES setup.
+ * The owner's exact 83-byte records must pass the existing independent SHA,
+ * CSV identity, scenario and projection gates before touching any live app.
+ * No ROM bytes are shipped, no original RNG/merchant/AI are invented.
+ */
+typedef enum {
+ GK162_ENTRY_OK=0,
+ GK162_ENTRY_ARGUMENT=1,
+ GK162_ENTRY_TEMPLATE=2,
+ GK162_ENTRY_SOURCE=3
+} Gk162EntryStatus;
+/* Atomic on failure, including source/bank mismatch. On success invalidates
+ * ALL prior Enhanced derived stages, including year-2, without altering either
+ * pristine PRE_SETUP template or the user's explicit Classic/Enhanced choice.
+ * The native controller gets the real first-Spring checkpoint menu with only
+ * pre-existing, source-bounded VIEW/PASS actions; it does not independently
+ * generate the NES first Spring nor imply 3 source-implemented actions.
+ */
