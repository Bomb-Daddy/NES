diff --git a/execution_199/gk230_win32_smoke_args.c b/execution_199/gk230_win32_smoke_args.c
new file mode 100644
index 0000000..8972c59
--- /dev/null
+++ b/execution_199/gk230_win32_smoke_args.c
@@ -0,0 +1,27 @@
+#include "gk230_win32_smoke_args.h"
+#include <stddef.h>
+#include <string.h>
+
+int gk230_win32_smoke_frames(const char *command_line, unsigned *frames){
+ static const char prefix[]="--smoke-frames=";
+ const char *p=command_line;
+ unsigned value=0u;
+ unsigned digits=0u;
+ if(!p||!frames)return -1;
+ while(*p==' '||*p=='\t')p++;
+ /* Preserve legacy non-smoke arguments; do not change normal game path. */
+ if(strncmp(p,"--smoke-frames",14)!=0)return 0;
+ if(strncmp(p,prefix,sizeof prefix-1u)!=0)return -1;
+ p+=sizeof prefix-1u;
+ if(*p=='0')return -1;
+ while(*p>='0'&&*p<='9'){
+   value=value*10u+(unsigned)(*p-'0');
+   if(value>120u)return -1;
+   p++;digits++;
+ }
+ if(!digits||value==0u)return -1;
+ while(*p==' '||*p=='\t')p++;
+ if(*p!='\0')return -1;
+ *frames=value;
+ return 1;
+}
diff --git a/execution_199/gk230_win32_smoke_args.h b/execution_199/gk230_win32_smoke_args.h
new file mode 100644
index 0000000..500344b
--- /dev/null
+++ b/execution_199/gk230_win32_smoke_args.h
@@ -0,0 +1,8 @@
+#ifndef GK230_WIN32_SMOKE_ARGS_H
+#define GK230_WIN32_SMOKE_ARGS_H
+/* Exact bounded WinMain GUI smoke mode. Only positive 1..120 frame counts.
+ *  1 = run finite GUI loop; 0 = unmodified normal launch; -1 = reject.
+ * WinMain supplies the command tail without executable path.
+ */
+int gk230_win32_smoke_frames(const char *command_line, unsigned *frames);
+#endif
diff --git a/execution_199/test_gk230_win32_smoke_args.c b/execution_199/test_gk230_win32_smoke_args.c
new file mode 100644
index 0000000..9ccfd79
--- /dev/null
+++ b/execution_199/test_gk230_win32_smoke_args.c
@@ -0,0 +1,25 @@
+#include "gk230_win32_smoke_args.h"
+#include <stdlib.h>
+#include <stdio.h>
+
+#define CHECK(e) do { if(!(e)){fprintf(stderr,"GK1_230 FAIL line %d\n", __LINE__);return 1;} }while(0)
+int main(void){
+ unsigned n=777u;
+ CHECK(gk230_win32_smoke_frames("",&n)==0&&n==777u);
+ CHECK(gk230_win32_smoke_frames(" --version ",&n)==0&&n==777u);
+ CHECK(gk230_win32_smoke_frames("--smoke-frames=1",&n)==1&&n==1u);
+ CHECK(gk230_win32_smoke_frames("  --smoke-frames=30 ", &n)==1&&n==30u);
+ CHECK(gk230_win32_smoke_frames("--smoke-frames=120",&n)==1&&n==120u);
+ const char *reject[]={"--smoke-frames", "--smoke-frames=", "--smoke-frames=0",
+  "--smoke-frames=121", "--smoke-frames=-1", "--smoke-frames=30 --other",
+  "--smoke-frames=4294967296", "--smoke-frames=3x", "--smoke-frames=+2",
+  "--smoke-frames 20", "--smoke-frames=00", "--smoke-frames=9999999999999"};
+ for(unsigned i=0;i<sizeof reject/sizeof *reject;i++){
+  n=777u;
+  CHECK(gk230_win32_smoke_frames(reject[i],&n)==-1&&n==777u);
+ }
+ CHECK(gk230_win32_smoke_frames("--smoke-frames=30",NULL)==-1);
+ CHECK(gk230_win32_smoke_frames(NULL,&n)==-1);
+ puts("GK1_230_PASS: bounded WinMain parser and invalid controls");
+ return 0;
+}
