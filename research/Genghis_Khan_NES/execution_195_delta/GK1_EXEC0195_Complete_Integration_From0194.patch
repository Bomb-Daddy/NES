diff -ruN a/README_EXEC0195.md b/README_EXEC0195.md
--- a/README_EXEC0195.md	1970-01-01 00:00:00.000000000 +0000
+++ b/README_EXEC0195.md	2026-11-11 15:09:09.615527536 +0000
@@ -0,0 +1,5 @@
+# EXEC0195 - Classic active-country VIEW and Pass source-ledger repair
+
+Built on complete EXEC0194. The existing Classic ASSIGN changes five worker occupation pools after a private original NES first-Spring checkpoint is imported. The game now renders a verified **before vs. after** player-country allocation under VIEW and reads the **same Classic three-order budget** when the player confirms PASS from the country screen. Previously the country screen displayed only original worker values and could debit the unrelated immutable stock checkpoint budget, leaving the derived allocation inconsistent. Gk195 view fails closed on tampered records or forged action history. It never changes source NES arrays, never guesses first-Spring RNG or opens extra commands. Other countries still show untouched source-only data. Both Classic and Enhanced APIs remain profile-separated. Nothing here demonstrates original stock NES parity or a full campaign.
+
+Reproduce: cmake -S execution_195 -B build195 -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build195 -j6 && ctest --test-dir build195 --output-on-failure -j6. For three authentic positive checks supply PRIVATE first-Spring source files to test_gk195_classic_view as CSV fresh.json archived1175.mss world1206.mss. Never distribute ROM, records, state, captures or GC19 files on public GitHub.
diff -ruN a/gk195_classic_view.c b/gk195_classic_view.c
--- a/gk195_classic_view.c	1970-01-01 00:00:00.000000000 +0000
+++ b/gk195_classic_view.c	2026-11-11 15:09:08.788934616 +0000
@@ -0,0 +1,32 @@
+#include "gk195_classic_view.h"
+#include <string.h>
+Gk195ViewResult gk195_classic_country_view(const Gk1App *app,
+ uint8_t country_index,Gk195CountryView *out){
+ if(!app||!out)return GK195_INVALID;
+ const Gk79Checkpoint *cp=&app->stock_checkpoint;
+ if(app->rules_profile!=0u||cp->valid!=1u||cp->source_verified!=1u||
+    !gk85_raw_source_intact(cp)||!gk88_stock_projection_intact(cp))
+  return GK195_SOURCE;
+ if(country_index>=cp->world.country_count||
+    cp->player_index>=cp->world.country_count)return GK195_INVALID;
+ if(app->classic_assign.active &&
+    !gk187_intact(&app->classic_assign,cp))return GK195_SOURCE;
+ Gk195CountryView v={0};
+ v.country_index=country_index;
+ v.is_player=country_index==cp->player_index;
+ v.original=cp->world.countries[country_index];
+ v.current=v.original;
+ v.remaining=cp->orders.remaining;
+ if(app->classic_assign.active){
+  v.actions=app->classic_assign.action_count;
+  v.remaining=app->classic_assign.budget.remaining;
+  v.passed=app->classic_assign.passed;
+  if(v.is_player){
+   v.current=app->classic_assign.mutable_world.countries[country_index];
+   v.derived=1u;
+  }
+ }
+ /* No pointers escape: this is a verified copy for the UI only. */
+ *out=v;
+ return GK195_OK;
+}
diff -ruN a/gk195_classic_view.h b/gk195_classic_view.h
--- a/gk195_classic_view.h	1970-01-01 00:00:00.000000000 +0000
+++ b/gk195_classic_view.h	2026-11-11 15:09:08.787012063 +0000
@@ -0,0 +1,14 @@
+#ifndef GK195_CLASSIC_VIEW_H
+#define GK195_CLASSIC_VIEW_H
+#include "gk1_app_state.h"
+/* Controller VIEW combines an immutable authenticated NES source with a
+ * separately replay-validated Classic allocation. No new NES first Spring,
+ * RNG or stock-accurate action is asserted by this derived view. */
+typedef enum {GK195_OK=0,GK195_INVALID=1,GK195_SOURCE=2} Gk195ViewResult;
+typedef struct {
+ Gk1CountryTemplate original, current;
+ uint8_t country_index, is_player, derived, actions, remaining, passed;
+} Gk195CountryView;
+Gk195ViewResult gk195_classic_country_view(const Gk1App *app,
+ uint8_t country_index,Gk195CountryView *out);
+#endif
