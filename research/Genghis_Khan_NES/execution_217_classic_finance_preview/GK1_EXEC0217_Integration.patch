diff --git a/execution_199/gk217_finance_preview.c b/execution_199/gk217_finance_preview.c
new file mode 100644
index 0000000..dd26887
--- /dev/null
+++ b/execution_199/gk217_finance_preview.c
@@ -0,0 +1,38 @@
+#include "gk217_finance_preview.h"
+#include <string.h>
+Gk217Status gk217_preview_country(const Gk1LoadedScenario *world,
+                                  unsigned country_index,Gk217Preview *out){
+ if(!world||!out||world->phase!=GK1_PRE_SETUP_TEMPLATE||
+    (world->scenario_id!=GK1_MONGOL_CONQUEST &&
+     world->scenario_id!=GK1_WORLD_CONQUEST)||
+    country_index>=world->country_count)return GK217_INVALID;
+ /* Existing source-grounded full-country engine rejects malformed identities,
+  * capacity/finance problems; do not silently fall back to a single-country
+  * computation that could mask corruption elsewhere in the 14/27-country map. */
+ Gk214Batch batch;
+ if(gk214_project_spring_batch(world,&batch)!=GK214_OK)
+  return GK217_FINANCE_REFUSED;
+ if(!batch.source_bounded_only||batch.generated_setup||batch.generated_rng||
+    batch.orders_granted||batch.after.phase!=GK1_PRE_SETUP_TEMPLATE||
+    batch.count!=world->country_count)return GK217_FINANCE_REFUSED;
+ const Gk1CountryTemplate *before=&world->countries[country_index];
+ const Gk1CountryTemplate *after=&batch.after.countries[country_index];
+ const Gk75SpringResult *delta=&batch.country[country_index];
+ Gk217Preview candidate={0};
+ candidate.country_count=batch.count;
+ candidate.selected_country=(uint8_t)country_index;
+ candidate.before_gold=before->gold;candidate.after_gold=after->gold;
+ candidate.before_food=before->goods[10];candidate.after_food=after->goods[10];
+ candidate.before_troops=before->troops;candidate.after_troops=after->troops;
+ candidate.troops_lost=delta->troops_lost;
+ candidate.taxes=delta->gross_tax;
+ candidate.payroll=delta->payroll;
+ candidate.food_consumed=delta->food_consumed;
+ candidate.total_taxes=batch.gross_taxes;
+ candidate.total_payroll=batch.payroll;
+ candidate.total_food_consumed=batch.food_consumed;
+ candidate.countries_starved=batch.starved_country_count;
+ candidate.original_spring_generated=0u;
+ *out=candidate;
+ return GK217_OK;
+}
diff --git a/execution_199/gk217_finance_preview.h b/execution_199/gk217_finance_preview.h
new file mode 100644
index 0000000..6a065db
--- /dev/null
+++ b/execution_199/gk217_finance_preview.h
@@ -0,0 +1,23 @@
+#ifndef GK217_FINANCE_PREVIEW_H
+#define GK217_FINANCE_PREVIEW_H
+#include "gk214_spring_batch.h"
+/* Copyright-clean, player-facing Classic finance explorer. This is an actual
+ * executable model of food/tax/pay over 14/27 country template data, NOT a
+ * reconstructed original NES setup, RNG scheduler, or playable first Spring.
+ * All results are value-only; no app state, orders or seasons are mutated. */
+typedef enum { GK217_OK=0, GK217_INVALID=1, GK217_FINANCE_REFUSED=2 } Gk217Status;
+typedef struct {
+  uint8_t country_count, selected_country, original_spring_generated;
+  uint16_t before_gold, after_gold, before_food, after_food;
+  uint16_t before_troops, after_troops;
+  uint16_t troops_lost;
+  uint32_t taxes, payroll, food_consumed;
+  uint32_t total_taxes, total_payroll, total_food_consumed;
+  uint16_t countries_starved;
+} Gk217Preview;
+/* Atomic failure: leaves the caller's output byte-for-byte unchanged.
+ * country_index is zero-based; world must be a native, legitimate 14/27-country
+ * PRE_SETUP dataset with fixed source country identities. */
+Gk217Status gk217_preview_country(const Gk1LoadedScenario *world,
+                                  unsigned country_index,Gk217Preview *out);
+#endif
diff --git a/execution_199/test_gk217_finance_preview.c b/execution_199/test_gk217_finance_preview.c
new file mode 100644
index 0000000..ee5b49a
--- /dev/null
+++ b/execution_199/test_gk217_finance_preview.c
@@ -0,0 +1,67 @@
+#include "gk1_app_state.h"
+#include "gk217_finance_preview.h"
+#include <stdio.h>
+#include <string.h>
+int main(int argc,char **argv){
+ if(argc!=2)return 2;
+ Gk1TemplateDataset data;
+ if(gk1_template_load(argv[1],&data)!=GK1_LOAD_OK)return 3;
+ Gk1App app;gk1_app_init(&app);
+ if(!gk1_app_install_templates(&app,&data))return 4;
+ unsigned cases=0;
+ for(unsigned w=0;w<2;w++){
+  const Gk1LoadedScenario original=app.worlds[w];
+  Gk214Batch all;
+  if(gk214_project_spring_batch(&app.worlds[w],&all)!=GK214_OK)return 5;
+  for(unsigned i=0;i<original.country_count;i++){
+   Gk217Preview view;
+   if(gk217_preview_country(&app.worlds[w],i,&view)!=GK217_OK)return 6;
+   if(view.country_count!=original.country_count||view.selected_country!=i||
+      view.original_spring_generated||view.before_gold!=original.countries[i].gold||
+      view.after_gold!=all.after.countries[i].gold||
+      view.before_food!=original.countries[i].goods[10]||
+      view.after_food!=all.after.countries[i].goods[10]||
+      view.total_taxes!=all.gross_taxes||view.total_payroll!=all.payroll||
+      view.total_food_consumed!=all.food_consumed)return 7;
+   ++cases;
+  }
+  if(memcmp(&original,&app.worlds[w],sizeof original))return 8;
+  Gk217Preview untouched;memset(&untouched,0xA5,sizeof untouched);
+  Gk217Preview marker=untouched;
+  if(gk217_preview_country(&app.worlds[w],original.country_count,&untouched)==GK217_OK||
+     memcmp(&marker,&untouched,sizeof marker))return 9;
+  Gk1LoadedScenario corrupt=original;
+  corrupt.countries[original.country_count-1].country_id=0;
+  if(gk217_preview_country(&corrupt,0,&untouched)==GK217_OK||
+     memcmp(&marker,&untouched,sizeof marker))return 10;
+  corrupt=original;corrupt.phase=(Gk1ScenarioPhase)2;
+  if(gk217_preview_country(&corrupt,0,&untouched)==GK217_OK||
+     memcmp(&marker,&untouched,sizeof marker))return 11;
+ }
+ /* Controller-only path, Classic vs Enhanced separation, actual D-pad scan,
+  * immutable original world and no invented playable Spring/merchant offers. */
+ app.screen=GK1_SCREEN_LABOR_PLAN;app.active_world=0;app.rules_profile=0;
+ Gk1LoadedScenario before=app.worlds[0];
+ if(!gk1_app_input(&app,GK1_INPUT_SETUP)||
+    app.screen!=GK1_SCREEN_LABOR_PLAN)return 12;
+ if(!gk1_app_input(&app,GK1_INPUT_SETUP)||
+    app.screen!=GK1_SCREEN_SPRING_FINANCE_PREVIEW)return 12;
+ if(!gk1_app_input(&app,GK1_INPUT_DOWN)||app.finance_cursor!=1u)return 13;
+ if(!gk1_app_input(&app,GK1_INPUT_LEFT)||app.finance_cursor!=0u)return 14;
+ if(!gk1_app_input(&app,GK1_INPUT_CANCEL)||
+    app.screen!=GK1_SCREEN_LABOR_PLAN)return 15;
+ if(memcmp(&before,&app.worlds[0],sizeof before)||
+    app.stock_checkpoint.valid||app.setup_stage[0]==GK53_SETUP_AWAIT_SOURCE)return 16;
+ app.active_world=1;app.rules_profile=0;app.screen=GK1_SCREEN_LABOR_PLAN;
+ if(!gk1_app_input(&app,GK1_INPUT_SETUP)||
+    app.screen!=GK1_SCREEN_LABOR_PLAN)return 17;
+ if(!gk1_app_input(&app,GK1_INPUT_SETUP)||
+    app.screen!=GK1_SCREEN_SPRING_FINANCE_PREVIEW)return 17;
+ if(app.finance_cursor!=0u)return 18;
+ if(!gk1_app_input(&app,GK1_INPUT_CANCEL))return 19;
+ app.rules_profile=1;app.screen=GK1_SCREEN_LABOR_PLAN;
+ if(!gk1_app_input(&app,GK1_INPUT_SETUP)||
+    app.screen!=GK1_SCREEN_DEMOBILIZE)return 20;
+ printf("EXEC0217 14+27=%u countries; Classic controller finance preview, source-bounded atomic refusal, Enhanced path preserved: PASS\n",cases);
+ return cases==41u?0:21;
+}
