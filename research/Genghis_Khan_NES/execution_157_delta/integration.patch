+/* An alternate, opt-in source tracing read. No invented sprite hit,
+ * overflow or PPU bus latch: only bit7 is returned, other seven bits
+ * remain symbolically unknown in the caller's CPU register model. */
+int gk157_ppu_status_symbolic(Gk103Ppu *p,uint64_t cycle,uint8_t *sign_bit){
+ uint64_t dot;
+ if(!p||!sign_bit||!p->render_window_active||p->rendering_unmodeled||
+    !at_dot(cycle,p->frame_origin_dots,&dot)||
+    dot>=p->render_window_limit_dot)return 0;
+ uint64_t within=dot%GK103_FRAME_DOTS;
+ if(within>=GK103_VBLANK_START-2u&&within<=GK103_VBLANK_START+2u){
+  p->race_gate=1u;return 0;
+ }
+ Gk103Ppu next=*p;
+ if(!gk103_ppu_advance(&next,cycle)||next.status_reads==UINT64_MAX||
+    next.nmi_pending)return 0;
+ uint8_t bit=next.vblank?0x80u:0u;
+ next.status_reads++;next.vblank=0u;
+ *p=next;*sign_bit=bit;
+ return bit?2:1;
+}
