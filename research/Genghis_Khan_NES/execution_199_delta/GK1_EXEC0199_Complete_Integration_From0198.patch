+ if(last.from!=5u||last.to!=5u||last.quantity<1u||last.quantity>100u)
+  return GK187_INVALID;
+ Gk187ClassicAssign restored=*state;
+ Gk187Result result=gk187_undo_last(&restored,source);
+ if(result!=GK187_OK)return result;
