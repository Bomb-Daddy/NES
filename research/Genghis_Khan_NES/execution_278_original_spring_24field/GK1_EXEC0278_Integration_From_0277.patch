--- a/execution_199/gk278_original_spring_coverage.h
+++ b/execution_199/gk278_original_spring_coverage.h
@@ -0,0 +1,40 @@
+#ifndef GK278_ORIGINAL_SPRING_COVERAGE_H
+#define GK278_ORIGINAL_SPRING_COVERAGE_H
+#include "gk215_original_spring_gap.h"
+/* EXEC0278: exhaustive *DIRECT* fields actually decoded from the original
+ * 83-byte country record into Gk1CountryTemplate. The port-derived reserve,
+ * population and history fields are intentionally excluded. No ROM assets.
+ * Index order is stable for independent QA and subsequent source tracing. */
+typedef enum {
+ GK278_ARMS, GK278_SKILL, GK278_TROOPS, GK278_ECONOMY,
+ GK278_TOWN, GK278_DEFENSE, GK278_MASONS, GK278_ARTISANS,
+ GK278_FOOD_WORKERS, GK278_GOLD, GK278_MORALE, GK278_TAX,
+ GK278_UNDRAFTED, GK278_FUR, GK278_SILK, GK278_JEWELS,
+ GK278_METALS, GK278_MEDICINES, GK278_WOODWORKS,
+ GK278_CERAMICS, GK278_GLASS, GK278_TEXTILES, GK278_PERFUME,
+ GK278_FOOD, GK278_FIELD_COUNT
+} Gk278Field;
+typedef enum {GK278_OK=0,GK278_ARGUMENT=1,GK278_TEMPLATE=2,
+ GK278_SOURCE=3,GK278_PROJECTION=4} Gk278Status;
+typedef struct {
+ uint16_t unequal_countries;
+ int64_t signed_residual;
+ int32_t minimum_residual,maximum_residual;
+} Gk278FieldGap;
+typedef struct {
+ uint8_t profile,scenario,country_count,source_observation_only;
+ uint8_t independent_initialization,generated_rng,generated_ai,playable_order_granted;
+ uint16_t compared_cells,unequal_cells,exact_cells;
+ uint16_t countries_with_differences;
+ uint16_t unequal_fields_per_country[GK1_COUNTRIES_WORLD];
+ Gk278FieldGap field[GK278_FIELD_COUNT];
+} Gk278Coverage;
+/* Exact authenticated stock source, canonical untouched template, same
+ * source-only Spring finance projection as EXEC0214/0215. No state mutation.
+ * On ANY refusal, out is byte-for-byte unchanged. This does not infer the
+ * original first-Spring initialization or treat projections as gameplay. */
+Gk278Status gk278_compare_original_spring_coverage(const char *canonical_csv,
+ const Gk1LoadedScenario *untouched_pre_setup,
+ const Gk79Checkpoint *original_stock_spring,Gk278Coverage *out);
+const char *gk278_field_name(Gk278Field field);
+#endif
--- a/execution_199/gk278_original_spring_coverage.c
+++ b/execution_199/gk278_original_spring_coverage.c
@@ -0,0 +1,75 @@
+#include "gk278_original_spring_coverage.h"
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+
+static const char *const field_names[GK278_FIELD_COUNT]={
+ "Arms","Skill","Troops","Economy","Town","Defense","Masons",
+ "Artisans","FoodWorkers","Gold","Morale","Tax","Undrafted",
+ "Fur","Silk","Jewels","Metals","Medicines","Woodworks",
+ "Ceramics","Glass","Textiles","Perfume","Food"
+};
+const char *gk278_field_name(Gk278Field field){
+ return (unsigned)field<GK278_FIELD_COUNT?field_names[field]:NULL;
+}
+static uint16_t direct_value(const Gk1CountryTemplate *c,unsigned ix){
+ switch(ix){
+ case GK278_ARMS:return c->arms;
+ case GK278_SKILL:return c->skill;
+ case GK278_TROOPS:return c->troops;
+ case GK278_ECONOMY:return c->economy;
+ case GK278_TOWN:return c->town;
+ case GK278_DEFENSE:return c->defense;
+ case GK278_MASONS:return c->masons;
+ case GK278_ARTISANS:return c->artisans;
+ case GK278_FOOD_WORKERS:return c->food_workers;
+ case GK278_GOLD:return c->gold;
+ case GK278_MORALE:return c->morale;
+ case GK278_TAX:return c->tax;
+ case GK278_UNDRAFTED:return c->undrafted_reserve;
+ default:return c->goods[ix-GK278_FUR];
+ }
+}
+Gk278Status gk278_compare_original_spring_coverage(const char *csv,
+ const Gk1LoadedScenario *pre,const Gk79Checkpoint *original,Gk278Coverage *out){
+ if(!csv||!*csv||!pre||!original||!out)return GK278_ARGUMENT;
+ /* Inherit the complete existing canonical-template, original 83-byte raw
+  * source SHA, RAM-bank profile, season/year/3-order and source-projection
+  * validation. Never weaken these guards to obtain a better-looking count. */
+ Gk215Gap *gate=(Gk215Gap*)malloc(sizeof *gate);
+ if(!gate)return GK278_ARGUMENT;
+ Gk215Status check=gk215_compare_original_spring(csv,pre,original,gate);
+ free(gate);
+ if(check!=GK215_OK)return check==GK215_TEMPLATE_REFUSED?GK278_TEMPLATE:
+  check==GK215_SOURCE_REFUSED?GK278_SOURCE:
+  check==GK215_FINANCE_REFUSED?GK278_PROJECTION:GK278_ARGUMENT;
+ Gk214Batch *baseline=(Gk214Batch*)malloc(sizeof *baseline);
+ if(!baseline)return GK278_ARGUMENT;
+ if(gk214_project_spring_batch(pre,baseline)!=GK214_OK){
+  free(baseline);return GK278_PROJECTION;
+ }
+ Gk278Coverage next={0};
+ next.profile=original->profile;next.scenario=(uint8_t)pre->scenario_id;
+ next.country_count=pre->country_count;next.source_observation_only=1u;
+ for(unsigned f=0;f<GK278_FIELD_COUNT;f++){
+  next.field[f].minimum_residual=INT32_MAX;
+  next.field[f].maximum_residual=INT32_MIN;
+  for(unsigned i=0;i<pre->country_count;i++){
+   const Gk1CountryTemplate *actual=&original->world.countries[i];
+   const Gk1CountryTemplate *projected=&baseline->after.countries[i];
+   int32_t delta=(int32_t)direct_value(actual,f)-direct_value(projected,f);
+   Gk278FieldGap *g=&next.field[f];
+   if(delta<g->minimum_residual)g->minimum_residual=delta;
+   if(delta>g->maximum_residual)g->maximum_residual=delta;
+   g->signed_residual+=delta;
+   if(delta){g->unequal_countries++;next.unequal_cells++;
+     next.unequal_fields_per_country[i]++;}
+  }
+ }
+ next.compared_cells=(uint16_t)(pre->country_count*GK278_FIELD_COUNT);
+ next.exact_cells=(uint16_t)(next.compared_cells-next.unequal_cells);
+ for(unsigned i=0;i<pre->country_count;i++)
+  if(next.unequal_fields_per_country[i])next.countries_with_differences++;
+ /* Source credentials do not authorize independently generated values. */
+ free(baseline);*out=next;return GK278_OK;
+}
--- a/execution_199/test_gk278_original_spring_coverage.c
+++ b/execution_199/test_gk278_original_spring_coverage.c
@@ -0,0 +1,99 @@
+#include "gk278_original_spring_coverage.h"
+#include "gk1_source_identity.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#define CHECK(c) do{if(!(c)){fprintf(stderr,"GK278 FAILED line %d: %s\n",__LINE__,#c);return 1;}checks++;}while(0)
+int main(int argc,char **argv){
+ unsigned checks=0;
+ if(argc!=2&&argc!=5){fprintf(stderr,"usage: %s CSV [PRIVATE_FRESH PRIVATE_ARCHIVED_MONGOL PRIVATE_ARCHIVED_WORLD]\n",argv[0]);return 2;}
+ CHECK(GK278_FIELD_COUNT==24u);
+ CHECK(gk278_field_name(GK278_ARMS)!=NULL);
+ CHECK(strcmp(gk278_field_name(GK278_FOOD),"Food")==0);
+ CHECK(gk278_field_name((Gk278Field)99)==NULL);
+ CHECK(gk1_verified_original_csv(argv[1]));
+ Gk1TemplateDataset *all=calloc(1,sizeof *all);
+ Gk1LoadedScenario *pre=calloc(1,sizeof *pre);
+ Gk79Checkpoint *stock=calloc(1,sizeof *stock);
+ Gk278Coverage *gap=malloc(sizeof *gap),*old=malloc(sizeof *old);
+ CHECK(all&&pre&&stock&&gap&&old);
+ CHECK(gk1_template_load(argv[1],all)==GK1_LOAD_OK);
+ for(unsigned w=1;w<=2;w++){
+  CHECK(gk1_open_loaded_scenario(all,(Gk1ScenarioId)w,pre)==GK1_LOAD_OK);
+  memset(gap,0xa7,sizeof *gap);*old=*gap;
+  CHECK(gk278_compare_original_spring_coverage(NULL,pre,stock,gap)==GK278_ARGUMENT);
+  CHECK(!memcmp(old,gap,sizeof *gap));
+  CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_SOURCE);
+  CHECK(!memcmp(old,gap,sizeof *gap));
+  CHECK(gk278_compare_original_spring_coverage("/noncanonical.csv",pre,stock,gap)==GK278_TEMPLATE);
+  CHECK(!memcmp(old,gap,sizeof *gap));
+  pre->countries[0].skill++;
+  CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_TEMPLATE);
+  CHECK(!memcmp(old,gap,sizeof *gap));
+ }
+ if(argc==5){
+  Gk278Coverage *fresh=malloc(sizeof *fresh),*arch=malloc(sizeof *arch);
+  CHECK(fresh&&arch);
+  for(unsigned p=1;p<=3;p++){
+   unsigned w=p==3u?2u:1u;
+   CHECK(gk1_open_loaded_scenario(all,(Gk1ScenarioId)w,pre)==GK1_LOAD_OK);
+   CHECK(gk79_open_original(pre,argv[1+p],(Gk77Profile)p,0,stock)==GK79_OK);
+   Gk79Checkpoint *saved=malloc(sizeof *saved);CHECK(saved);
+   *saved=*stock;
+   CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_OK);
+   CHECK(gap->scenario==w&&gap->profile==p&&gap->country_count==(w==1u?14u:27u));
+   CHECK(gap->source_observation_only==1u&&!gap->independent_initialization&&
+    !gap->generated_rng&&!gap->generated_ai&&!gap->playable_order_granted);
+   CHECK(gap->compared_cells==(w==1u?336u:648u));
+   CHECK(gap->exact_cells+gap->unequal_cells==gap->compared_cells);
+   CHECK(gap->unequal_cells>0u&&gap->countries_with_differences>0u);
+   unsigned field_unequal_sum=0u;
+   for(unsigned f=0;f<GK278_FIELD_COUNT;f++){
+    CHECK(gap->field[f].unequal_countries<=gap->country_count);
+    CHECK(gap->field[f].minimum_residual<=gap->field[f].maximum_residual);
+    field_unequal_sum+=gap->field[f].unequal_countries;
+   }
+   CHECK(field_unequal_sum==gap->unequal_cells);
+   unsigned row_unequal_sum=0u;
+   for(unsigned i=0;i<gap->country_count;i++)row_unequal_sum+=gap->unequal_fields_per_country[i];
+   CHECK(row_unequal_sum==gap->unequal_cells);
+   /* Two legacy finance-projection fields must align with GK215's
+    * independently gated original-Spring residual report. */
+   Gk215Gap *legacy=malloc(sizeof *legacy);CHECK(legacy);
+   CHECK(gk215_compare_original_spring(argv[1],pre,stock,legacy)==GK215_OK);
+   CHECK(gap->field[GK278_GOLD].unequal_countries==legacy->gold_mismatches);
+   CHECK(gap->field[GK278_FOOD].unequal_countries==legacy->food_mismatches);
+   CHECK(gap->field[GK278_TROOPS].unequal_countries==legacy->troop_mismatches);
+   free(legacy);
+   CHECK(!memcmp(saved,stock,sizeof *stock));
+   if(p==1u)*fresh=*gap;
+   if(p==2u)*arch=*gap;
+   *old=*gap;
+   stock->stock_raw[0][0]^=1u;
+   CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_SOURCE);
+   CHECK(!memcmp(old,gap,sizeof *gap));*stock=*saved;
+   stock->world.countries[0].skill++;
+   CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_SOURCE);
+   CHECK(!memcmp(old,gap,sizeof *gap));*stock=*saved;
+   stock->orders.remaining=2u;
+   CHECK(gk278_compare_original_spring_coverage(argv[1],pre,stock,gap)==GK278_SOURCE);
+   CHECK(!memcmp(old,gap,sizeof *gap));*stock=*saved;
+   printf("OBSERVED_RUNTIME_STOCK_%s: %u direct source-record cells, %u unequal / %u exact vs SOURCE-BOUNDED pre-setup finance (NOT generated Spring); Skill mismatches=%u, Arms=%u, Gold=%u, Food=%u\n",
+    p==1u?"FRESH_RESET":p==2u?"ARCHIVED_MONGOL":"ARCHIVED_WORLD",
+    gap->compared_cells,gap->unequal_cells,gap->exact_cells,
+    gap->field[GK278_SKILL].unequal_countries,
+    gap->field[GK278_ARMS].unequal_countries,
+    gap->field[GK278_GOLD].unequal_countries,
+    gap->field[GK278_FOOD].unequal_countries);
+   free(saved);
+  }
+  /* Do not collapse two independently observed stock first-Spring
+   * RNG histories into a fabricated universal stat initialization. */
+  CHECK(fresh->profile==GK77_FRESH_MONGOL_WORKRAM);
+  CHECK(arch->profile==GK77_ARCHIVED_MONGOL_SAVERAM);
+  free(fresh);free(arch);
+ }else puts("PUBLIC negative-only QA: no private records packaged or first Spring generated.");
+ printf("GK278 %u assertions PASS; ORIGINAL SETUP/RNG STILL OPEN.\n",checks);
+ free(all);free(pre);free(stock);free(gap);free(old);
+ return 0;
+}
