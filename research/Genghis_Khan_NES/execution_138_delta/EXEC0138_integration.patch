+  candidate.inspected++;
+  uint64_t p=prior_odd(post_state);
+  if(!(p&1u)||(((UINT64_C(0)-(p*GK138_MULT))&GK138_MASK)!=post_state))
+   return GK138_BAD_INPUT;
+  post_state=p;
+ }
+ *out=candidate;
+ return GK138_OK;
+}
