diff --git a/execution_199/gk209_archived_rate_ambiguity.c b/execution_199/gk209_archived_rate_ambiguity.c
new file mode 100644
index 0000000..44f7eb7
--- /dev/null
+++ b/execution_199/gk209_archived_rate_ambiguity.c
@@ -0,0 +1,34 @@
+#include "gk209_archived_rate_ambiguity.h"
+#include <string.h>
+Gk209Status gk209_archived_rate_ambiguity(const char *rom,const char *mss,
+ Gk77Profile profile,uint32_t window,Gk209RateAmbiguity *out){
+ if(!rom||!*rom||!mss||!*mss||!out||window==0u||window>65536u||
+    (profile!=GK77_ARCHIVED_MONGOL_SAVERAM&&
+     profile!=GK77_ARCHIVED_WORLD_SAVERAM))return GK209_ARGUMENT;
+ Gk208ArchiveProof source={0};
+ Gk208Status status=gk208_archived_source_rng(rom,mss,profile,&source);
+ if(status!=GK208_OK)
+  return (status==GK208_ARCHIVE||status==GK208_ARCHIVE_IDENTITY)?
+      GK209_ARCHIVE_REFUSED:GK209_SOURCE_REFUSED;
+ /* Source arithmetic produces odd output seed; even Mesen state could be
+  * mid-calculation or externally altered. Do not pretend it is an output. */
+ if(!(source.archived_seed48&UINT64_C(1)))return GK209_NOT_A_DRAW_BOUNDARY;
+ Gk209RateAmbiguity candidate={0};
+ candidate.profile=profile;
+ candidate.archived_pc=source.archived_pc;
+ candidate.window=window;
+ candidate.observed_spring_rate=(profile==GK77_ARCHIVED_WORLD_SAVERAM)?114u:101u;
+ for(unsigned d=1;d<=5u;d++){
+  Gk138RateScan scan={0};
+  if(gk138_scan_spring_rate(source.archived_seed48,(uint8_t)d,
+       candidate.observed_spring_rate,window,&scan)!=GK138_OK)
+   return GK209_NOT_A_DRAW_BOUNDARY;
+  candidate.by_difficulty[d-1u]=scan;
+  if(scan.matches>0u)candidate.candidate_difficulties++;
+  if(scan.matches==1u)candidate.uniquely_located_difficulties++;
+ }
+ /* Neither a single candidate nor an apparent unique match establishes
+  * an authentic 6502 call chronology. Always mark both gates false. */
+ *out=candidate;
+ return GK209_OK;
+}
diff --git a/execution_199/gk209_archived_rate_ambiguity.h b/execution_199/gk209_archived_rate_ambiguity.h
new file mode 100644
index 0000000..67e10c6
--- /dev/null
+++ b/execution_199/gk209_archived_rate_ambiguity.h
@@ -0,0 +1,32 @@
+#ifndef GK209_ARCHIVED_RATE_AMBIGUITY_H
+#define GK209_ARCHIVED_RATE_AMBIGUITY_H
+#include "gk208_archived_rng.h"
+#include "gk138_rng_reverse.h"
+/* EXEC0209: ROM-and-full-Mesen-state-attested *candidate* past Rate draws.
+ * This is retrospective arithmetic only: a matching value cannot prove
+ * which RNG call (if any) was used for Spring Rate, or recover startup setup.
+ * Never modifies an original checkpoint, mutable campaign, ROM or Mesen file.
+ */
+typedef enum {
+ GK209_OK=0,GK209_ARGUMENT=1,GK209_SOURCE_REFUSED=2,
+ GK209_ARCHIVE_REFUSED=3,GK209_NOT_A_DRAW_BOUNDARY=4
+} Gk209Status;
+typedef struct {
+ Gk77Profile profile;
+ uint16_t observed_spring_rate;
+ uint16_t archived_pc;
+ uint32_t window;
+ uint8_t candidate_difficulties;
+ uint8_t uniquely_located_difficulties;
+ uint8_t chronology_proved; /* always zero: no runtime RNG call log */
+ uint8_t first_spring_generated; /* always zero */
+ Gk138RateScan by_difficulty[5];
+} Gk209RateAmbiguity;
+/* Bounded 1..65536 reverse draws, independent for each difficulty (1..5).
+ * Returns NOT_A_DRAW_BOUNDARY if the original CPU seed is even: a partial
+ * RNG computation/non-draw write is possible, so reverse-draw provenance
+ * must not be fabricated. On every refusal, *out is byte-identical. */
+Gk209Status gk209_archived_rate_ambiguity(const char *original_rom,
+ const char *archived_mss,Gk77Profile profile,uint32_t window,
+ Gk209RateAmbiguity *out);
+#endif
diff --git a/execution_199/test_gk209_archived_rate_ambiguity.c b/execution_199/test_gk209_archived_rate_ambiguity.c
new file mode 100644
index 0000000..9e47a55
--- /dev/null
+++ b/execution_199/test_gk209_archived_rate_ambiguity.c
@@ -0,0 +1,47 @@
+#include "gk209_archived_rate_ambiguity.h"
+#include <stdio.h>
+#include <string.h>
+static int checks=0;
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"GK209 FAIL:%d %s\n",__LINE__,#x);return 2;}checks++;}while(0)
+int main(int argc,char **argv){
+ Gk209RateAmbiguity out,old;
+ memset(&out,0xa5,sizeof out);old=out;
+ CHECK(gk209_archived_rate_ambiguity(0,"mss",GK77_ARCHIVED_MONGOL_SAVERAM,64,&out)==GK209_ARGUMENT);
+ CHECK(gk209_archived_rate_ambiguity("rom",0,GK77_ARCHIVED_MONGOL_SAVERAM,64,&out)==GK209_ARGUMENT);
+ CHECK(gk209_archived_rate_ambiguity("rom","mss",GK77_FRESH_MONGOL_WORKRAM,64,&out)==GK209_ARGUMENT);
+ CHECK(gk209_archived_rate_ambiguity("rom","mss",GK77_ARCHIVED_MONGOL_SAVERAM,0,&out)==GK209_ARGUMENT);
+ CHECK(gk209_archived_rate_ambiguity("rom","mss",GK77_ARCHIVED_WORLD_SAVERAM,65537,&out)==GK209_ARGUMENT);
+ CHECK(!memcmp(&out,&old,sizeof out));
+ CHECK(gk209_archived_rate_ambiguity("badrom","no_file",GK77_ARCHIVED_MONGOL_SAVERAM,64,&out)==GK209_ARCHIVE_REFUSED);
+ CHECK(!memcmp(&out,&old,sizeof out));
+ if(argc==4){
+  const char *rom=argv[1],*mongol=argv[2],*world=argv[3];
+  Gk209RateAmbiguity a,b;
+  Gk209Status ra=gk209_archived_rate_ambiguity(rom,mongol,GK77_ARCHIVED_MONGOL_SAVERAM,4096,&a);
+  Gk209Status rb=gk209_archived_rate_ambiguity(rom,world,GK77_ARCHIVED_WORLD_SAVERAM,4096,&b);
+  CHECK(ra==GK209_OK||ra==GK209_NOT_A_DRAW_BOUNDARY);
+  CHECK(rb==GK209_OK||rb==GK209_NOT_A_DRAW_BOUNDARY);
+  if(ra==GK209_OK){
+   const uint32_t mongol_expected[5]={45,31,28,42,29};
+   for(unsigned d=0;d<5u;d++)CHECK(a.by_difficulty[d].matches==mongol_expected[d]);
+   CHECK(a.candidate_difficulties==5u && a.uniquely_located_difficulties==0u);
+   CHECK(a.observed_spring_rate==101u && a.window==4096u);
+   CHECK(a.chronology_proved==0u&&a.first_spring_generated==0u);
+   for(unsigned d=0;d<5;d++)CHECK(a.by_difficulty[d].inspected==4096u);
+   Gk209RateAmbiguity tmp=out;
+   CHECK(gk209_archived_rate_ambiguity(rom,world,GK77_ARCHIVED_MONGOL_SAVERAM,64,&out)==GK209_ARCHIVE_REFUSED);
+   CHECK(!memcmp(&out,&tmp,sizeof out));
+  }
+  if(rb==GK209_OK){
+   const uint32_t world_expected[5]={46,39,40,24,38};
+   for(unsigned d=0;d<5u;d++)CHECK(b.by_difficulty[d].matches==world_expected[d]);
+   CHECK(b.candidate_difficulties==5u && b.uniquely_located_difficulties==0u);
+   CHECK(b.observed_spring_rate==114u && b.window==4096u);
+   CHECK(b.chronology_proved==0u&&b.first_spring_generated==0u);
+   for(unsigned d=0;d<5;d++)CHECK(b.by_difficulty[d].inspected==4096u);
+  }
+  printf("AUTHENTIC MONGOL archive diagnostic status=%d; WORLD=%d; no startup claim\n",ra,rb);
+ }
+ printf("GK209 PASS %d checks; no original session or first Spring generated\n",checks);
+ return 0;
+}
