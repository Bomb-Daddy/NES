@@ -0,0 +1,16 @@
+# EXEC0140 — verified Mesen saved-state PRNG lineage compatibility
+
+Continues **the full EXEC0139 native C11 game**. Independent memory-safe C11 code
+checks whether two authenticated Mesen CPU-RAM `$84..$89` snapshots *could*
+be related by 0..65,536 direct original NES 48-bit PRNG draws. The `Gk1App`
+method is read-only, guarded by `GK53_SETUP_AWAIT_SOURCE`, and does not unlock
+campaign, legal orders, trade, or original first Spring. A compatible count
+**never establishes actual draw count** because interrupts and unrelated
+writes may have modified the six bytes. A nonmatch means there is no *pure*
+PRNG chain inside the bounded interval, NOT that either observation is fake.
+
+This is explicitly **VERIFIED_STATIC**, not a new Mesen runtime observation.
+Original stock archived Mesen states remain private; no ROM, SRAM, licensed
+art/audio or raw savestate is included in public files. Native Linux QA tests
+both parser integration and independent mathematical oracle; Win32/NSIS/physical
+Xbox and full campaigns are NOT RUN.
--- a/gk140_rng_lineage.c
+++ b/gk140_rng_lineage.c
@@ -0,0 +1,48 @@
+#include "gk140_rng_lineage.h"
+#include "gk137_stock_rng.h"
+#include <stdint.h>
+Gk140Result gk140_compare_mesen_seed_lineage(const Gk139MesenProof *earlier,
+ const Gk139MesenProof *later,uint32_t maximum_draws,Gk140Lineage *out){
+ if(!earlier||!later||!out||maximum_draws>65536u||
+    earlier->cpu_cycles>later->cpu_cycles||
+    !earlier->field_count||!later->field_count||
+    earlier->country_bank==GK139_BANK_UNKNOWN||
+    earlier->country_bank!=later->country_bank||
+    earlier->seed48>UINT64_C(0xffffffffffff)||
+    later->seed48>UINT64_C(0xffffffffffff)||
+    (!(later->seed48&1u)&&earlier->seed48!=later->seed48))
+  return GK140_LINEAGE_BAD_INPUT;
+ /* Reject a malformed synthetic proof in which bytes and 48-bit value
+  * disagree; archived proof is read-only but input can be tampered with. */
+ uint64_t s1=0,s2=0;
+ for(unsigned i=0;i<6u;i++){
+  s1=(s1<<8u)|earlier->nes_seed[i];
+  s2=(s2<<8u)|later->nes_seed[i];
+ }
+ if(s1!=earlier->seed48||s2!=later->seed48)
+  return GK140_LINEAGE_BAD_INPUT;
+ Gk140Lineage candidate={0};
+ candidate.only_prng_is_unproven=1u;
+ candidate.elapsed_cpu_cycles=later->cpu_cycles-earlier->cpu_cycles;
+ Gk137StockRng rng={0};
+ rng.seed48=earlier->seed48;
+ /* A PRNG draw consumes at least one CPU cycle. Exclude any candidate
+  * draw count greater than the actual observed elapsed CPU cycles. */
+ uint64_t limit=maximum_draws;
+ if(candidate.elapsed_cpu_cycles<limit)limit=candidate.elapsed_cpu_cycles;
+ for(uint32_t i=0;i<=(uint32_t)limit;i++){
+  candidate.tested_transitions++;
+  if(rng.seed48==later->seed48){
+   if(!candidate.compatible_counts)candidate.nearest_count=i;
+   candidate.farthest_count=i;
+   candidate.compatible_counts++;
+  }
+  if((uint64_t)i<limit){
+   uint16_t ignored=0;
+   if(gk137_draw15(&rng,&ignored)!=GK137_OK)
+    return GK140_LINEAGE_BAD_INPUT;
+  }
+ }
+ if(!candidate.compatible_counts)return GK140_LINEAGE_NO_PURE_CHAIN;
+ *out=candidate;return GK140_LINEAGE_OK;
+}
--- a/gk140_rng_lineage.h
+++ b/gk140_rng_lineage.h
@@ -0,0 +1,26 @@
+#ifndef GK140_RNG_LINEAGE_H
+#define GK140_RNG_LINEAGE_H
+#include <stdint.h>
+#include "gk139_mesen_state.h"
+/* A compatibility calculation, NOT a proof of intervening PRNG calls.
+ * CPU-RAM state may be perturbed by NMI, game setup, or unknown writes.
+ * Never turn these matches into a player-ready original Spring. */
+typedef enum {
+ GK140_LINEAGE_OK=0, GK140_LINEAGE_BAD_INPUT=1,
+ GK140_LINEAGE_NO_PURE_CHAIN=2
+} Gk140Result;
+typedef struct {
+ uint32_t tested_transitions;
+ uint32_t compatible_counts;
+ uint32_t nearest_count;
+ uint32_t farthest_count;
+ uint64_t elapsed_cpu_cycles;
+ uint8_t only_prng_is_unproven; /* always true even for a unique match */
+} Gk140Lineage;
+/* Observations must be externally authenticated and belong to one scenario,
+ * to a monotonic CPU timeline and a single physical country RAM bank.
+ * Search counts 0..maximum_draws inclusive; capped at 65,536.
+ * On any rejection, *out is unchanged. */
+Gk140Result gk140_compare_mesen_seed_lineage(const Gk139MesenProof *earlier,
+ const Gk139MesenProof *later,uint32_t maximum_draws,Gk140Lineage *out);
+#endif
