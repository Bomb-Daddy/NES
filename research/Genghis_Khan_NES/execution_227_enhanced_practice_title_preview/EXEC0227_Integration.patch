diff --git a/execution_199/gk227_practice_title_preview.c b/execution_199/gk227_practice_title_preview.c
new file mode 100644
index 0000000..987c79e
--- /dev/null
+++ b/execution_199/gk227_practice_title_preview.c
@@ -0,0 +1,64 @@
+#if !defined(_WIN32)
+#define _POSIX_C_SOURCE 200809L
+#endif
+#include "gk227_practice_title_preview.h"
+#include "gk224_practice_save.h"
+#include "gk1_source_identity.h"
+#include <string.h>
+#include <errno.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#endif
+Gk227PreviewStatus gk227_preview_practice_slot(const char *path,
+ const char *csv,const Gk1LoadedScenario sources[2],Gk227Preview *out){
+ if(!path||!*path||!csv||!*csv||!sources||!out||strlen(path)>4096u)
+  return GK227_PREVIEW_UNAVAILABLE;
+ /* Refuse a replayed receipt against partial or modified installed data.
+  * The canonical original CSV SHA is a source-identity gate, not RNG evidence. */
+ if(!gk1_verified_original_csv(csv)||
+    sources[0].scenario_id!=GK1_MONGOL_CONQUEST||sources[0].country_count!=14u||
+    sources[1].scenario_id!=GK1_WORLD_CONQUEST||sources[1].country_count!=27u||
+    sources[0].phase!=GK1_PRE_SETUP_TEMPLATE||
+    sources[1].phase!=GK1_PRE_SETUP_TEMPLATE)return GK227_PREVIEW_SOURCE;
+#ifdef _WIN32
+ DWORD attrs=GetFileAttributesA(path);
+ if(attrs==INVALID_FILE_ATTRIBUTES){
+  DWORD last=GetLastError();
+  return last==ERROR_FILE_NOT_FOUND||last==ERROR_PATH_NOT_FOUND?
+   GK227_PREVIEW_MISSING:GK227_PREVIEW_UNAVAILABLE;
+ }
+ if(attrs&(FILE_ATTRIBUTE_REPARSE_POINT|FILE_ATTRIBUTE_DIRECTORY))
+  return GK227_PREVIEW_UNAVAILABLE;
+#else
+ struct stat info;
+ if(lstat(path,&info)!=0)
+  return errno==ENOENT?GK227_PREVIEW_MISSING:GK227_PREVIEW_UNAVAILABLE;
+ if(!S_ISREG(info.st_mode))return GK227_PREVIEW_UNAVAILABLE;
+#endif
+ Gk222Spring state={0};uint8_t command=0;
+ int source_mismatch=0,corrupt=0;
+ for(unsigned world=0;world<2u;world++){
+  Gk224Status result=gk224_load(path,csv,&sources[world],&state,&command);
+  if(result==GK224_OK){
+   if(state.scenario!=world+1u||state.player_index>=sources[world].country_count||
+      state.actions_committed>3u||state.remaining>3u||
+      state.remaining+state.actions_committed!=3u)return GK227_PREVIEW_CORRUPT;
+   Gk227Preview value={0};
+   value.scenario=state.scenario;
+   value.country_count=sources[world].country_count;
+   value.player_index=state.player_index;
+   value.actions_committed=state.actions_committed;
+   value.orders_remaining=state.remaining;
+   value.command=command;
+   *out=value;
+   return GK227_PREVIEW_OK;
+  }
+  if(result==GK224_SOURCE)source_mismatch=1;
+  else if(result==GK224_CORRUPT||result==GK224_STATE)corrupt=1;
+  else if(result==GK224_UNAVAILABLE)return GK227_PREVIEW_UNAVAILABLE;
+ }
+ return corrupt?GK227_PREVIEW_CORRUPT:source_mismatch?
+  GK227_PREVIEW_SOURCE:GK227_PREVIEW_UNAVAILABLE;
+}
diff --git a/execution_199/gk227_practice_title_preview.h b/execution_199/gk227_practice_title_preview.h
new file mode 100644
index 0000000..d1cce40
--- /dev/null
+++ b/execution_199/gk227_practice_title_preview.h
@@ -0,0 +1,21 @@
+#ifndef GK227_PRACTICE_TITLE_PREVIEW_H
+#define GK227_PRACTICE_TITLE_PREVIEW_H
+#include "gk1_app_state.h"
+#include <stdint.h>
+/* Enhanced PORT-only title inventory. Does not change the running game or
+ * certify NES first-Spring, RNG, historical checkpoints or full saves. */
+typedef enum {
+ GK227_PREVIEW_OK=0, GK227_PREVIEW_MISSING, GK227_PREVIEW_SOURCE,
+ GK227_PREVIEW_CORRUPT, GK227_PREVIEW_UNAVAILABLE
+} Gk227PreviewStatus;
+typedef struct {
+ uint8_t scenario, country_count, player_index;
+ uint8_t actions_committed, orders_remaining, command;
+} Gk227Preview;
+/* The two scenario templates must be the complete unmodified 14/27-country
+ * public original CSV-derived set. On EVERY failure, *out is byte-unchanged.
+ * Rejects symlinks/reparse points, directories, truncated/extended records,
+ * invalid source, and forged receipt. Does not touch Gk1App. */
+Gk227PreviewStatus gk227_preview_practice_slot(const char *path,
+ const char *csv,const Gk1LoadedScenario sources[2],Gk227Preview *out);
+#endif
diff --git a/execution_199/test_gk227_practice_title_preview.c b/execution_199/test_gk227_practice_title_preview.c
new file mode 100644
index 0000000..22201e9
--- /dev/null
+++ b/execution_199/test_gk227_practice_title_preview.c
@@ -0,0 +1,89 @@
+#if !defined(_WIN32)
+#define _POSIX_C_SOURCE 200809L
+#endif
+#include "gk227_practice_title_preview.h"
+#include "gk226_practice_checkpoint.h"
+#include "gk224_practice_save.h"
+#include "gk1_source_identity.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <unistd.h>
+#endif
+#define CHECK(x) do{if(!(x)){fprintf(stderr,"GK227 FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+static int trial(const char *csv,const Gk1TemplateDataset *dataset,unsigned world){
+ Gk1App *app=calloc(1,sizeof *app);CHECK(app);
+ gk1_app_init(app);CHECK(gk1_app_install_templates(app,dataset));
+ Gk222Spring *practice=calloc(1,sizeof *practice);CHECK(practice);
+ uint8_t player=(uint8_t)(world?6:1);
+ CHECK(gk222_open(&app->worlds[world],player,practice)==GK222_OK);
+ char file[640];
+#ifdef _WIN32
+ const char *dir=getenv("TEMP");if(!dir||!*dir)dir=".";
+ unsigned long pid=GetCurrentProcessId();
+ const char slash='\\';
+#else
+ const char *dir=getenv("TMPDIR");if(!dir||!*dir)dir="/tmp";
+ unsigned long pid=(unsigned long)getpid();
+ const char slash='/';
+#endif
+ CHECK(snprintf(file,sizeof file,"%s%cgk227_%lu_%u.gk24",dir,slash,pid,world)>0);
+ remove(file);
+ Gk227Preview sentinel={0xEF,0xEF,0xEF,0xEF,0xEF,0xEF};
+ Gk227Preview value=sentinel;
+ CHECK(gk227_preview_practice_slot(file,csv,app->worlds,&value)==GK227_PREVIEW_MISSING);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ CHECK(gk226_practice_checkpoint(file,csv,&app->worlds[world],practice,1)==GK224_OK);
+ CHECK(gk227_preview_practice_slot(file,csv,app->worlds,&value)==GK227_PREVIEW_OK);
+ CHECK(value.scenario==world+1u&&value.country_count==(world?27:14)&&
+       value.player_index==player&&value.actions_committed==0&&
+       value.orders_remaining==3&&value.command==1);
+ CHECK(gk222_apply(practice,player,GK222_ASSIGN_TOWN_TO_FOOD)==GK222_OK);
+ CHECK(gk222_apply(practice,player,GK222_PASS)==GK222_OK);
+ CHECK(gk226_practice_checkpoint(file,csv,&app->worlds[world],practice,0)==GK224_OK);
+ CHECK(gk227_preview_practice_slot(file,csv,app->worlds,&value)==GK227_PREVIEW_OK);
+ CHECK(value.actions_committed==2&&value.orders_remaining==1&&value.command==0);
+ value=sentinel;
+ Gk1LoadedScenario *sources=malloc(2*sizeof *sources);CHECK(sources);
+ memcpy(sources,app->worlds,2*sizeof *sources);
+ sources[world].countries[5].gold++;
+ CHECK(gk227_preview_practice_slot(file,csv,sources,&value)==GK227_PREVIEW_SOURCE);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ memcpy(sources,app->worlds,2*sizeof *sources);
+ sources[0].country_count=13;
+ CHECK(gk227_preview_practice_slot(file,csv,sources,&value)==GK227_PREVIEW_SOURCE);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ memcpy(sources,app->worlds,2*sizeof *sources);
+ CHECK(gk227_preview_practice_slot(file,"/definitely/nonexistent.csv",sources,&value)==GK227_PREVIEW_SOURCE);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ FILE *f=fopen(file,"r+b");CHECK(f);
+ CHECK(fseek(f,15,SEEK_SET)==0);int original=fgetc(f);CHECK(original>=0);
+ CHECK(fseek(f,15,SEEK_SET)==0&&fputc(original^1,f)!=EOF&&fclose(f)==0);
+ CHECK(gk227_preview_practice_slot(file,csv,sources,&value)==GK227_PREVIEW_CORRUPT);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ CHECK(remove(file)==0);
+ f=fopen(file,"wb");CHECK(f&&fwrite("bad",1,3,f)==3&&fclose(f)==0);
+ CHECK(gk227_preview_practice_slot(file,csv,sources,&value)==GK227_PREVIEW_CORRUPT);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ CHECK(remove(file)==0);
+#ifndef _WIN32
+ char target[700];CHECK(snprintf(target,sizeof target,"%s.target",file)>0);
+ f=fopen(target,"wb");CHECK(f&&fwrite("bad",1,3,f)==3&&fclose(f)==0);
+ CHECK(symlink(target,file)==0);
+ CHECK(gk227_preview_practice_slot(file,csv,sources,&value)==GK227_PREVIEW_UNAVAILABLE);
+ CHECK(memcmp(&value,&sentinel,sizeof value)==0);
+ CHECK(unlink(file)==0&&remove(target)==0);
+#endif
+ free(sources);free(practice);free(app);return 0;
+}
+int main(int argc,char **argv){
+ CHECK(argc==2&&gk1_verified_original_csv(argv[1]));
+ Gk1TemplateDataset *dataset=calloc(1,sizeof *dataset);CHECK(dataset);
+ CHECK(gk1_template_load(argv[1],dataset)==GK1_LOAD_OK);
+ CHECK(trial(argv[1],dataset,0)==0&&trial(argv[1],dataset,1)==0);
+ free(dataset);
+ puts("EXEC0227 SOURCE-BOUND 14/27 Enhanced title slot preview and corruption/partial/symlink nonmutation PASS; no NES Spring generated");return 0;
+}
