+ CHECK(gk239_owner_world_startup(a,argv[1],argv[1],NULL,1,0)==GK239_REFUSED);
+ CHECK(gk239_owner_world_startup(a,"/not/found.csv","/not/found.mss",NULL,1,0)==GK239_REFUSED);
+ CHECK(gk239_owner_world_startup(NULL,argv[1],"/not/found.mss",NULL,1,0)==GK239_REFUSED);
+ CHECK(memcmp(a,before,sizeof *a)==0);
+ CHECK(a->worlds[0].country_count==14u&&a->worlds[1].country_count==27u);
+ CHECK(a->screen==GK1_SCREEN_TITLE);
+ if(argc==4){
+  /* Optional owner-local positive original World Mesen state and distinct
+   * original Mongol state. Neither may ship with a public ZIP/installer. */
+  CHECK(gk239_owner_world_startup(a,argv[1],argv[2],NULL,1,1)==GK239_SMOKE_ISOLATED);
+  CHECK(memcmp(a,before,sizeof *a)==0);
+  CHECK(gk239_owner_world_startup(a,argv[1],argv[3],NULL,1,0)==GK239_REFUSED);
+  CHECK(memcmp(a,before,sizeof *a)==0);
+  CHECK(gk239_owner_world_startup(a,argv[1],argv[2],NULL,1,0)==GK239_IMPORTED);
+  CHECK(a->screen==GK1_SCREEN_STOCK_CONTINUE);
+  CHECK(a->stock_checkpoint.valid&&a->stock_checkpoint.source_verified);
+  CHECK(a->stock_checkpoint.profile==GK77_ARCHIVED_WORLD_SAVERAM);
+  CHECK(a->stock_checkpoint.year==1206u&&a->stock_checkpoint.rate==114u);
+  CHECK(a->stock_checkpoint.world.country_count==27u);
+  CHECK(a->stock_checkpoint.orders.remaining==3u);
+  CHECK(a->active_world==1u&&a->rules_profile==0u);
+  CHECK(memcmp(a->worlds,before->worlds,sizeof a->worlds)==0);
+  CHECK(gk85_raw_source_intact(&a->stock_checkpoint));
+  *before=*a;
+  CHECK(gk239_owner_world_startup(a,argv[1],argv[2],NULL,1,0)==GK239_REFUSED);
+  CHECK(memcmp(a,before,sizeof *a)==0);
+ }
+ printf("EXEC0239 %u assertions PASS; archived original World owner state import; no NES first Spring RNG or Xbox\n",checks);
+ free(a);free(before);free(ds);return 0;
+}
diff --git a/execution_199/test_gk240_archived_optional_zlib.c b/execution_199/test_gk240_archived_optional_zlib.c
new file mode 100644
index 0000000..3fdbd3b
--- /dev/null
+++ b/execution_199/test_gk240_archived_optional_zlib.c
@@ -0,0 +1,48 @@
+/* EXEC0240: build-contract test for optional Mesen inflater.
+ * No copyrighted source bytes, no owner paths, no artificial successful import.
+ * It deliberately differentiates no-zlib from a zlib-enabled build.
+ */
+#include "gk182_archived_source_bank.h"
+#include "gk163_mesen_import.h"
+#include <stdio.h>
+#include <string.h>
+int main(void){
+ Gk182SavedBankProof proof;
+ memset(&proof,0x5a,sizeof proof);
+ if(gk182_original_saved_bank(NULL,"/missing/private.mss",
+    GK77_ARCHIVED_WORLD_SAVERAM,&proof)!=GK182_ARGUMENT)return 1;
+ if(gk182_original_saved_bank("/missing/private.nes",NULL,
+    GK77_ARCHIVED_WORLD_SAVERAM,&proof)!=GK182_ARGUMENT)return 2;
+ if(gk182_original_saved_bank("/missing/private.nes","/missing/private.mss",
+    (Gk77Profile)99,&proof)!=GK182_ARGUMENT)return 3;
+ Gk182Status status=gk182_original_saved_bank("/missing/private.nes",
+    "/missing/private.mss",GK77_ARCHIVED_WORLD_SAVERAM,&proof);
+#ifdef GK163_HAS_ZLIB
+ if(status!=GK182_SOURCE)return 4;
+ puts("EXEC0240 PASS: zlib build refuses missing original source; no private input used");
+#else
+ if(status!=GK182_UNAVAILABLE)return 5;
+ puts("EXEC0240 PASS: no-zlib build explicitly refuses original importer");
+#endif
+ /* Both entry points reject absent private source and do not mutate output. */
+ unsigned char records[GK163_MAX_RECORDS];
+ memset(records,0xc3,sizeof records);
+ size_t count=17u;
+ Gk139MesenProof cpu;
+ memset(&cpu,0xa1,sizeof cpu);
+ Gk163Status unpack=gk163_mesen_extract_with_proof("/missing/private.mss",
+    GK77_ARCHIVED_WORLD_SAVERAM,records,&count,&cpu);
+#ifdef GK163_HAS_ZLIB
+ if(unpack!=GK163_IO)return 7;
+#else
+ if(unpack!=GK163_UNAVAILABLE)return 8;
+#endif
+ if(count!=17u)return 9;
+ for(size_t i=0;i<sizeof records;i++)if(records[i]!=0xc3)return 10;
+ const unsigned char *cp=(const unsigned char *)&cpu;
+ for(size_t i=0;i<sizeof cpu;i++)if(cp[i]!=0xa1)return 11;
+ /* Failure must not hand back fabricated source proof. */
+ const unsigned char *b=(const unsigned char *)&proof;
+ for(size_t i=0;i<sizeof proof;i++)if(b[i]!=0x5a)return 6;
+ return 0;
+}
diff --git a/execution_199/test_gk241_archived_import_capability.c b/execution_199/test_gk241_archived_import_capability.c
new file mode 100644
index 0000000..816f732
--- /dev/null
+++ b/execution_199/test_gk241_archived_import_capability.c
@@ -0,0 +1,37 @@
+#include "gk241_archived_import_capability.h"
+#include "gk239_owner_world_mss.h"
+#include "gk1_source_identity.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#define CHECK(test) do {if(!(test)){fprintf(stderr,"GK241 assertion %d: %s\n",__LINE__,#test);return 1;} checks++;}while(0)
+int main(int argc,char **argv){
+ if(argc!=2)return 2;
+ unsigned checks=0;
+ Gk1TemplateDataset *ds=malloc(sizeof *ds);
+ Gk1App *app=malloc(sizeof *app);
+ Gk1App *before=malloc(sizeof *before);
+ if(!ds||!app||!before)return 3;
+ gk1_app_init(app);
+ CHECK(gk1_template_load(argv[1],ds)==GK1_LOAD_OK);
+ CHECK(gk1_app_install_templates(app,ds));
+ *before=*app;
+#ifdef GK163_HAS_ZLIB
+ CHECK(gk241_archived_import_backend()==GK241_ARCHIVE_BACKEND_ZLIB);
+ CHECK(strstr(gk241_archived_refusal_message(),"EXACT ORIGINAL SAVERAM")!=NULL);
+#else
+ CHECK(gk241_archived_import_backend()==GK241_ARCHIVE_BACKEND_UNAVAILABLE);
+ CHECK(strstr(gk241_archived_refusal_message(),"LACKS ZLIB")!=NULL);
+#endif
+ CHECK(gk239_owner_world_startup(app,argv[1],"/missing/stock.mss",NULL,1,1)==GK239_SMOKE_ISOLATED);
+ CHECK(memcmp(app,before,sizeof *app)==0);
+ CHECK(gk239_owner_world_startup(app,argv[1],"/missing/stock.mss","/missing/fresh.json",1,0)==GK239_CONFLICTING_SOURCES);
+ CHECK(memcmp(app,before,sizeof *app)==0);
+ CHECK(gk239_owner_world_startup(app,argv[1],"/missing/stock.mss",NULL,1,0)==GK239_REFUSED);
+ CHECK(memcmp(app,before,sizeof *app)==0);
+ CHECK(app->worlds[0].country_count==14u && app->worlds[1].country_count==27u);
+ CHECK(app->screen==GK1_SCREEN_TITLE);
+ CHECK(app->stock_checkpoint.valid==0u);
+ printf("EXEC0241 %u assertion PASS; backend=%d (NO private original loaded, Windows NOT RUN)\n",checks,(int)gk241_archived_import_backend());
+ free(before);free(app);free(ds);return 0;
+}
diff --git a/execution_199/test_gk242_win32_archive_link.c b/execution_199/test_gk242_win32_archive_link.c
new file mode 100644
index 0000000..a781be6
--- /dev/null
+++ b/execution_199/test_gk242_win32_archive_link.c
@@ -0,0 +1,37 @@
+/* EXEC0242: archive-backend link-and-runtime test. Copyright-clean;
+ * synthetic compressed bytes only, never original ROM/Mesen evidence. */
+#include "gk241_archived_import_capability.h"
+#include <zlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdint.h>
+#ifndef GK163_HAS_ZLIB
+#error "EXEC0242 release-archive test was compiled without required ZLIB"
+#endif
+#define CHECK(cond) do { if (!(cond)) { \
+ fprintf(stderr,"EXEC0242 assertion failed at %d: %s\n",__LINE__,#cond); \
+ return 1; } ++checks; } while(0)
+int main(void) {
+ static const Bytef source[]="GK1-EXEC0242 synthetic-archive-backend 27 countries; not Mesen data";
+ Bytef zipped[256], unzipped[sizeof(source)];
+ uLongf zipped_size=sizeof zipped;
+ uLongf output_size=sizeof unzipped;
+ unsigned checks=0;
+ CHECK(gk241_archived_import_backend()==GK241_ARCHIVE_BACKEND_ZLIB);
+ CHECK(zlibVersion()!=NULL && zlibVersion()[0]!='\0');
+ CHECK(compressBound(sizeof source)<=sizeof zipped);
+ CHECK(compress2(zipped,&zipped_size,source,sizeof source,Z_BEST_COMPRESSION)==Z_OK);
+ CHECK(zipped_size>8 && zipped_size<sizeof source+16);
+ CHECK(uncompress(unzipped,&output_size,zipped,zipped_size)==Z_OK);
+ CHECK(output_size==sizeof source);
+ CHECK(memcmp(unzipped,source,sizeof source)==0);
+ zipped[0]^=0x5au;
+ output_size=sizeof unzipped;
+ CHECK(uncompress(unzipped,&output_size,zipped,zipped_size)!=Z_OK);
+#if defined(_WIN32)
+ printf("EXEC0242 TESTED_PORT_WIN32 synthetic DEFLATE link/runtime and source backend %u assertions PASS; not physical Xbox or original NES\n",checks);
+#else
+ printf("EXEC0242 TESTED_PORT_LINUX synthetic DEFLATE link/runtime and source backend %u assertions PASS; Windows not tested by this process\n",checks);
+#endif
+ return 0;
+}
