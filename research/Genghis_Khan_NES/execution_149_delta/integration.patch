index 0000000..19bfd72
--- /dev/null
+++ b/README_EXEC0149.md
@@ -0,0 +1,9 @@
+# EXEC0149 — Source-authenticated PPU phase-origin gate investigation
+
+Version 1.49.0-dev1. Continued from the **complete inherited EXEC0148** 1280×720 C11 Linux/Win32 game (not a new isolated prototype). Added `gk149_ppu_phase_scan.c/.h`, source-tested `Gk1App` API, CLI `--source-phase-scan`, and an executable regression test. The selected 35 reset origins and DMA phase are **explicit experimental hypotheses**, **not observed Mesen hardware timing**. Private input original USA ROM SHA256 `ada7066d9e71a81310fff78bc7037126798018a69dc2b92382c3cbdcd9b243b3` is checked at runtime; ROM or raw gameplay evidence never ships with the source or installer.
+
+The unseeded original boot still stops at unknown `$00F5`. The explicitly configured Mesen AllZeros 6502 boot gets to PPUSTATUS `$2002`. A bounded phase-origin scan (0..34 PPU dots) yielded **17 PPUSTATUS race gates at `$C5BE`** and **18 rendering-enable PPUMASK gates at `$C5E9`**, original source write `$2001=$1E`. This establishes that under explicit phase variants a further **unmodeled rendering** gate appears beyond the old PPUSTATUS gate. It does **not** establish the original NES reset phase, real Mesen gameplay, actual RNG call order, or the 14/27 country first Spring. No controller actions or original Spring countries are unlocked by the code.
+
+Test: `cmake -S execution_149 -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j8 && ctest --test-dir build --output-on-failure`; optional private positive test `GK1_ORIGINAL_STOCK_ROM=/absolute/private/stock.nes ctest --test-dir build -R GK1_149 -V`; direct CLI `gk1_native_shell --source-phase-scan /absolute/private/stock.nes`. Source rejected atomically. Preserves original source/setup and existing enhanced-only controller gameplay, save/cold-load and previous tests.
+
+**OPEN:** independent source-authentic first playable Spring, true original three orders and RNG/difficulty/character setup, realistic PPU rendering, original Trade merchant presence, AI, dynasty, diplomacy, battle aftermath and full campaigns. Win32/NSIS and physical Xbox **NOT RUN** until separately tested.
diff --git a/gk149_ppu_phase_scan.c b/gk149_ppu_phase_scan.c
new file mode 100644
index 0000000..0e8c13d
--- /dev/null
+++ b/gk149_ppu_phase_scan.c
@@ -0,0 +1,49 @@
+#include "gk149_ppu_phase_scan.h"
+#include "gk83_reset_trace.h"
+#include "gk129_dma_source.h"
+#include "gk82_stock_cartridge.h"
+#include <string.h>
+#include <limits.h>
+
+Gk149Status gk149_scan_original_reset_phases(const char *rom,Gk149PhaseScan *out){
+ if(!rom||!*rom||!out)return GK149_INVALID;
+ Gk82RomBootstrap boot;
+ if(gk82_probe_stock_rom(rom,&boot)!=GK82_ROM_OK)return GK149_SOURCE_REFUSED;
+ Gk149PhaseScan next={0};
+ for(unsigned origin=0;origin<GK149_PHASE_COUNT;origin++){
+  Gk83Trace trace={0};
+  /* Explicitly hypothetical reset-origin and APU DMA alignment; no actual
+   * original Mesen PPU timing, pixel rendering or controller sequence. */
+  Gk83Stop stop=gk129_trace_original_ppu_with_dma_alignment(
+   rom,origin,1u,0u,120000u,&trace);
+  if(stop==GK83_SOURCE_REFUSED)return GK149_SOURCE_REFUSED;
+  if(stop==GK83_INVALID)return GK149_INVALID;
+  next.origins_checked++;
+  if(UINT32_MAX-next.vblank_set_reads<trace.ppu_status_vblank_values||
+     UINT32_MAX-next.ppu_status_reads<trace.ppu_scheduled_status_reads)
+   return GK149_UNEXPECTED_GATE;
+  next.vblank_set_reads+=trace.ppu_status_vblank_values;
+  next.ppu_status_reads+=trace.ppu_scheduled_status_reads;
+  if(stop==GK83_HARDWARE_GATE && trace.ppu_scheduled_race_gate &&
+     trace.stop_pc==0xc5beu){
+   next.ppu_race_stops++;
+   if(!next.first_race_pc)next.first_race_pc=trace.stop_pc;
+  }else if(stop==GK83_HARDWARE_GATE &&
+     trace.first_unmodelled_io_write==0x2001u &&
+     (trace.first_unmodelled_io_value&0x18u) &&
+     !trace.ppu_scheduled_race_gate){
+   next.render_enable_stops++;
+   if(!next.first_render_pc){
+    next.first_render_origin=(uint8_t)origin;
+    next.first_render_pc=trace.stop_pc;
+    next.first_render_mask=trace.first_unmodelled_io_value;
+    next.first_render_cycles=trace.completed_cpu_cycles;
+   }
+  }else next.other_stops++;
+ }
+ /* A complete result includes even unfamiliar new source gates so source
+  * divergence is visible, but the result is never promoted to gameplay. */
+ next.spring_created=0u;
+ *out=next;
+ return next.other_stops?GK149_UNEXPECTED_GATE:GK149_BOUNDED;
+}
diff --git a/gk149_ppu_phase_scan.h b/gk149_ppu_phase_scan.h
new file mode 100644
index 0000000..c65cb34
--- /dev/null
+++ b/gk149_ppu_phase_scan.h
@@ -0,0 +1,24 @@
+#ifndef GK149_PPU_PHASE_SCAN_H
+#define GK149_PPU_PHASE_SCAN_H
+#include <stdint.h>
+/* Source-authenticated 6502/Ppu reset research. 35 EXPLICIT phase-origin
+ * hypotheses; none is an observed original Mesen clock origin. No ROM bytes,
+ * initial 14/27-country records or licensed assets are shipped or generated. */
+#define GK149_PHASE_COUNT 35u
+typedef enum {
+ GK149_INVALID=0, GK149_SOURCE_REFUSED=1,
+ GK149_BOUNDED=2, GK149_UNEXPECTED_GATE=3
+} Gk149Status;
+typedef struct {
+ uint8_t origins_checked,ppu_race_stops,render_enable_stops,other_stops;
+ uint8_t first_render_origin,first_render_mask;
+ uint16_t first_render_pc,first_race_pc;
+ uint32_t vblank_set_reads,ppu_status_reads;
+ uint64_t first_render_cycles;
+ uint8_t spring_created; /* hard zero: this is a source trace, not game init */
+} Gk149PhaseScan;
+/* Only authenticated original USA ROM hash is accepted. A rejected source
+ * leaves output entirely unchanged. Does not mutate campaign state. */
+Gk149Status gk149_scan_original_reset_phases(const char *private_rom,
+                                             Gk149PhaseScan *out);
+#endif
