diff -ruN execution_192/README_EXEC0193.md execution_193/README_EXEC0193.md
--- execution_192/README_EXEC0193.md	1970-01-01 00:00:00.000000000 +0000
+++ execution_193/README_EXEC0193.md	2026-11-11 13:10:47.274483006 +0000
@@ -0,0 +1,7 @@
+# Genghis Khan I — EXEC0193 (research v1.93.0-dev1)
+
+Original 1280x720 Windows/XInput and Linux/X11 C11 game, based on the **complete** EXEC0192 source. Exact original USA ROM and private 83-byte country records are **not shipped**.
+
+**New executable behavior:** `--play-original-auto <owner-private snapshot>` or `--smoke-original-auto <snapshot> <frames>` recognizes *by its contents* an authenticated original Mesen archived-state `.mss` (Mongol 14 or World 27 countries, correct active **SaveRAM** bank), or the single authenticated fresh `14_after_wait` reset JSON (14 countries, **WorkRAM**). It delegates source SHA/bank validation to established native original importers, commits the verified native `Gk1App` only on success, and returns the detected profile. Wrong-bank, tampered, missing, incompatible Enhanced profile and wrong canonical CSV all fail without mutation. No private source data is written, logged, distributed or embedded. This continues the real stock checkpoint with existing Classic controller actions; it **does not independently synthesize original first Spring**, NES RNG or full Classic campaigns.
+
+Build from the **whole** inherited historical archive, not GitHub delta alone. Hostile test `test_gk193_auto_source_entry <canonical 41-country CSV> [private fresh JSON] [private archived Mongol.mss] [private archived World.mss]` checks exact live native world, three-source recognition, and negative full-struct rollback. Private files remain local, never in GitHub or installers. Windows binary/NSIS and physical Xbox device not tested.
diff -ruN execution_192/gk193_auto_source_entry.c execution_193/gk193_auto_source_entry.c
--- execution_192/gk193_auto_source_entry.c	1970-01-01 00:00:00.000000000 +0000
+++ execution_193/gk193_auto_source_entry.c	2026-11-11 13:10:45.121256661 +0000
@@ -0,0 +1,56 @@
+#include "gk193_auto_source_entry.h"
+#include "gk164_mss_entry.h"
+#include "gk166_fresh_entry.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+Gk193Result gk193_enter_original_auto(Gk1App *app, const char *csv,
+ const char *source, uint8_t player, Gk77Profile *detected){
+ if(!app||!csv||!*csv||!source||!*source||!detected||player!=0u)
+  return GK193_ARGUMENT;
+ /* A private stock snapshot must never be silently imported into Enhanced.
+  * All three evidence profiles retain the original canonical template gate
+  * within the delegated source-authenticated original importers. */
+ if(app->rules_profile!=0u)return GK193_TEMPLATE;
+ FILE *fp=fopen(source,"rb");
+ if(!fp)return GK193_UNAVAILABLE;
+ uint8_t signature[4]={0};
+ size_t n=fread(signature,1,sizeof signature,fp);
+ int read_error=ferror(fp),close_error=fclose(fp);
+ if(read_error||close_error)return GK193_UNAVAILABLE;
+ if(n!=sizeof signature)return GK193_SOURCE;
+ const int mesen=memcmp(signature,"MSS\1",4)==0;
+ /* The ONLY other supported evidence is fresh original Mesen JSON.
+  * Neither a ROM nor a renamed arbitrary file is a recognized snapshot. */
+ if(!mesen&&signature[0]!='{')return GK193_SOURCE;
+ Gk1App *candidate=(Gk1App*)malloc(sizeof *candidate);
+ if(!candidate)return GK193_UNAVAILABLE;
+ Gk193Result result=GK193_SOURCE;
+ Gk77Profile chosen=GK77_FRESH_MONGOL_WORKRAM;
+ if(mesen){
+  const Gk77Profile profiles[2]={
+   GK77_ARCHIVED_MONGOL_SAVERAM,GK77_ARCHIVED_WORLD_SAVERAM};
+  for(unsigned i=0;i<2;i++){
+   memcpy(candidate,app,sizeof *candidate);
+   Gk164Result r=gk164_enter_original_mss(candidate,csv,source,profiles[i],player);
+   if(r==GK164_OK){chosen=profiles[i];result=GK193_OK;break;}
+   if(r==GK164_TEMPLATE){result=GK193_TEMPLATE;break;}
+   if(r==GK164_SOURCE_UNAVAILABLE){result=GK193_UNAVAILABLE;break;}
+  }
+ }else{
+  memcpy(candidate,app,sizeof *candidate);
+  Gk166Result r=gk166_enter_original_fresh_json(candidate,csv,source,player);
+  if(r==GK166_OK)result=GK193_OK;
+  else if(r==GK166_TEMPLATE)result=GK193_TEMPLATE;
+  else if(r==GK166_SOURCE_UNAVAILABLE)result=GK193_UNAVAILABLE;
+ }
+ if(result==GK193_OK){
+  /* This is the only caller-visible world mutation. Both pristine original
+   * scenario templates and every inherited application subsystem survive. */
+  memcpy(app,candidate,sizeof *app);
+  *detected=chosen;
+ }
+ memset(candidate,0,sizeof *candidate);free(candidate);
+ return result;
+}
