diff --git a/execution_199/gk207_seed_write_watch.c b/execution_199/gk207_seed_write_watch.c
new file mode 100644
index 0000000..82d716c
--- /dev/null
+++ b/execution_199/gk207_seed_write_watch.c
@@ -0,0 +1,27 @@
+#include "gk207_seed_write_watch.h"
+#include <limits.h>
+Gk207Status gk207_note_completed_seed_store(Gk207SeedWatch *watch,
+ uint16_t pc,uint16_t address,uint8_t value,
+ uint8_t bank_known,uint8_t bank,uint64_t cycle){
+ if(!watch||pc<0x8000u||bank_known>1u||bank>15u||!cycle)
+  return GK207_INVALID;
+ if(address>=0x2000u || (address&0x07ffu)<0x0084u ||
+    (address&0x07ffu)>0x0089u)return GK207_OUTSIDE;
+ if(watch->completed_writes==UINT32_MAX ||
+    (watch->completed_writes>=GK207_MAX_STORED_EVENTS &&
+     watch->dropped_details==UINT32_MAX))return GK207_INVALID;
+ const uint8_t index=(uint8_t)((address&0x07ffu)-0x84u);
+ const Gk207SeedEvent event={pc,address,index,value,bank_known,
+                             bank_known?bank:0xffu,cycle};
+ if(watch->completed_writes<GK207_MAX_STORED_EVENTS)
+  watch->first[watch->completed_writes]=event;
+ else watch->dropped_details++;
+ watch->completed_writes++;
+ watch->latest_written[index]=value;
+ watch->written_mask=(uint8_t)(watch->written_mask|(1u<<index));
+ watch->last=event;
+ return GK207_RECORDED;
+}
+int gk207_source_written_complete(const Gk207SeedWatch *w){
+ return w && w->written_mask==GK207_FULL_SIX_WRITES;
+}
diff --git a/execution_199/gk207_seed_write_watch.h b/execution_199/gk207_seed_write_watch.h
new file mode 100644
index 0000000..f8bd677
--- /dev/null
+++ b/execution_199/gk207_seed_write_watch.h
@@ -0,0 +1,28 @@
+#ifndef GK207_SEED_WRITE_WATCH_H
+#define GK207_SEED_WRITE_WATCH_H
+#include <stdint.h>
+/* Execution of actual decoded 6502 RAM stores by the guarded interpreter;
+ * not a static ROM-pattern search and NOT live Mesen gameplay. Only writes
+ * witnessed after reset count. Unknown power-on bytes never become a seed. */
+#define GK207_MAX_STORED_EVENTS 32u
+#define GK207_FULL_SIX_WRITES UINT8_C(0x3f)
+typedef enum {GK207_INVALID=0,GK207_OUTSIDE=1,GK207_RECORDED=2} Gk207Status;
+typedef struct {
+ uint16_t pc, cpu_address;
+ uint8_t byte_index, value, bank_known, bank;
+ uint64_t cpu_cycle;
+} Gk207SeedEvent;
+typedef struct {
+ uint32_t completed_writes, dropped_details;
+ uint8_t written_mask; /* 1 bit per $0084..$0089, NEVER inferred from power-on */
+ uint8_t latest_written[6]; /* only valid where corresponding mask bit set */
+ Gk207SeedEvent first[GK207_MAX_STORED_EVENTS],last;
+} Gk207SeedWatch;
+/* Reject bad arguments/overflow atomically. All internal RAM mirrors accepted.
+ * RAM stores at $0084..$0089 only; PPU, mapper, PRG-RAM stores never alias.
+ * Caller provides CPU-executed instruction PC and final STORE bus cycle. */
+Gk207Status gk207_note_completed_seed_store(Gk207SeedWatch *watch,
+ uint16_t source_pc,uint16_t cpu_address,uint8_t value,
+ uint8_t bank_known,uint8_t bank,uint64_t final_cpu_cycle);
+int gk207_source_written_complete(const Gk207SeedWatch *watch);
+#endif
