diff --git a/execution_199/gk204_selector_store_inventory.c b/execution_199/gk204_selector_store_inventory.c
new file mode 100644
index 0000000..826a262
--- /dev/null
+++ b/execution_199/gk204_selector_store_inventory.c
@@ -0,0 +1,76 @@
+#include "gk204_selector_store_inventory.h"
+#include "gk202_irq_rng_dispatch.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define GK204_HEADER 16u
+#define GK204_BANK_SIZE 16384u
+#define GK204_BANKS 16u
+static int direct_store(uint8_t op){
+ return op==0x84u||op==0x85u||op==0x86u;
+}
+static int direct_rmw(uint8_t op){
+ return op==0x06u||op==0x26u||op==0x46u||op==0x66u||
+        op==0xc6u||op==0xe6u;
+}
+static int indexed_candidate(uint8_t op){
+ return op==0x94u||op==0x95u||op==0x96u||op==0x16u||
+        op==0x36u||op==0x56u||op==0x76u||op==0xd6u||op==0xf6u;
+}
+static int absolute_candidate(uint8_t op){
+ return op==0x8cu||op==0x8du||op==0x8eu||op==0x0eu||
+        op==0x2eu||op==0x4eu||op==0x6eu||op==0xceu||op==0xeeu;
+}
+Gk204Status gk204_inventory_bytes(const uint8_t *rom,size_t len,Gk204Inventory *out){
+ if(!rom||!out)return GK204_ARGUMENT;
+ Gk202Proof proof={0};
+ if(gk202_analyze_authenticated_bytes(rom,len,&proof)!=GK202_OK)
+  return GK204_SOURCE_REFUSED;
+ Gk204Inventory r={0};
+ r.verified_original_stock=1;
+ r.source_only_not_runtime=1;
+ r.rng_selector=proof.rng_slot;
+ for(unsigned bank=0;bank<GK204_BANKS;bank++){
+  const uint8_t *p=rom+GK204_HEADER+(size_t)bank*GK204_BANK_SIZE;
+  for(size_t i=0;i+1u<GK204_BANK_SIZE;i++){
+   if(p[i+1u]!=0x50u)continue;
+   uint8_t kind=0;
+   if(direct_store(p[i]))kind=GK204_RAW_DIRECT_STORE;
+   else if(direct_rmw(p[i]))kind=GK204_RAW_DIRECT_RMW;
+   else if(indexed_candidate(p[i]))kind=GK204_RAW_INDEXED_CANDIDATE;
+   else if(absolute_candidate(p[i])&&i+2u<GK204_BANK_SIZE&&p[i+2u]==0u)
+    kind=GK204_RAW_ABSOLUTE_CANDIDATE;
+   if(!kind)continue;
+   if(r.site_count>=GK204_MAX_CANDIDATES)return GK204_TOO_MANY;
+   Gk204Site *s=&r.sites[r.site_count++];
+   s->bank=(uint8_t)bank;
+   s->bank_offset=(uint16_t)i;
+   s->hypothetical_pc=(uint16_t)(i+(bank==15u?0xc000u:0x8000u));
+   s->opcode=p[i];s->kind=kind;
+   if(kind==GK204_RAW_DIRECT_STORE){
+    r.raw_direct_store_count++;
+    if(p[i]==0x85u&&i>=2u&&p[i-2u]==0xa9u){
+     s->adjacent_lda_immediate=1;s->immediate_value=p[i-1u];
+     if(s->immediate_value==proof.rng_slot)r.adjacent_lda_rng_store_count++;
+    }
+   }else if(kind==GK204_RAW_DIRECT_RMW)r.raw_direct_rmw_count++;
+   else if(kind==GK204_RAW_INDEXED_CANDIDATE)r.raw_indexed_count++;
+   else r.raw_absolute_count++;
+  }
+ }
+ /* This bounds only exact raw byte patterns from the immutable original
+  * cartridge. Do not assert the original CPU executed any candidate. */
+ *out=r;return GK204_OK;
+}
+Gk204Status gk204_inventory_file(const char *name,Gk204Inventory *out){
+ if(!name||!*name||!out)return GK204_ARGUMENT;
+ FILE *f=fopen(name,"rb");if(!f)return GK204_SOURCE_REFUSED;
+ uint8_t *data=(uint8_t*)malloc(GK202_STOCK_ROM_BYTES+1u);
+ if(!data){fclose(f);return GK204_SOURCE_REFUSED;}
+ size_t n=fread(data,1,GK202_STOCK_ROM_BYTES+1u,f);
+ int err=ferror(f),closed=fclose(f);
+ Gk204Status result=(!err&&!closed&&n==GK202_STOCK_ROM_BYTES)?
+  gk204_inventory_bytes(data,n,out):GK204_SOURCE_REFUSED;
+ memset(data,0,GK202_STOCK_ROM_BYTES+1u);free(data);
+ return result;
+}
diff --git a/execution_199/gk204_selector_store_inventory.h b/execution_199/gk204_selector_store_inventory.h
new file mode 100644
index 0000000..5460d23
--- /dev/null
+++ b/execution_199/gk204_selector_store_inventory.h
@@ -0,0 +1,39 @@
+#ifndef GK204_SELECTOR_STORE_INVENTORY_H
+#define GK204_SELECTOR_STORE_INVENTORY_H
+#include <stddef.h>
+#include <stdint.h>
+/* Original USA NES only. All entries are raw PRG byte-sequence candidates,
+ * NEVER disassembled reachable instructions, executed BRKs, or Spring RNG.
+ * Candidate PC in banks 0..14 is a hypothetical $8000-$BFFF window.
+ * The fixed bank (15) is at $C000-$FFFF. */
+#define GK204_MAX_CANDIDATES 64u
+typedef enum { GK204_OK=0, GK204_ARGUMENT=1,
+ GK204_SOURCE_REFUSED=2, GK204_TOO_MANY=3 } Gk204Status;
+typedef enum { GK204_RAW_DIRECT_STORE=1, GK204_RAW_DIRECT_RMW=2,
+ GK204_RAW_INDEXED_CANDIDATE=3, GK204_RAW_ABSOLUTE_CANDIDATE=4 } Gk204Kind;
+typedef struct {
+ uint8_t bank;
+ uint16_t bank_offset;
+ uint16_t hypothetical_pc;
+ uint8_t opcode;
+ uint8_t kind;
+ uint8_t adjacent_lda_immediate;
+ uint8_t immediate_value; /* meaningful only when adjacent_lda_immediate */
+} Gk204Site;
+typedef struct {
+ uint8_t verified_original_stock;
+ uint8_t source_only_not_runtime;
+ uint8_t rng_selector; /* from authenticated GK202 IRQ dispatch table, decimal17 */
+ uint8_t site_count;
+ uint8_t raw_direct_store_count;
+ uint8_t raw_direct_rmw_count;
+ uint8_t raw_indexed_count;
+ uint8_t raw_absolute_count;
+ uint8_t adjacent_lda_rng_store_count;
+ Gk204Site sites[GK204_MAX_CANDIDATES];
+} Gk204Inventory;
+/* Both calls are failure-atomic; no output write on refusal.
+ * Never passes private ROM bytes to a report or a public source archive. */
+Gk204Status gk204_inventory_bytes(const uint8_t *,size_t,Gk204Inventory *);
+Gk204Status gk204_inventory_file(const char *,Gk204Inventory *);
+#endif
diff --git a/execution_199/test_gk204_selector_store_inventory.c b/execution_199/test_gk204_selector_store_inventory.c
new file mode 100644
index 0000000..bfa04a0
--- /dev/null
+++ b/execution_199/test_gk204_selector_store_inventory.c
@@ -0,0 +1,62 @@
+#include "gk204_selector_store_inventory.h"
+#include "gk1_app_state.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static unsigned checks;
+#define CHECK(c) do{checks++;if(!(c)){fprintf(stderr,"GK204 FAIL %u: %s\n",__LINE__,#c);return 1;}}while(0)
+int main(int argc,char **argv){
+ Gk204Inventory result,baseline;
+ memset(&result,0xa5,sizeof result);baseline=result;
+ CHECK(gk204_inventory_bytes(NULL,0,&result)==GK204_ARGUMENT);
+ CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ CHECK(gk204_inventory_file(NULL,&result)==GK204_ARGUMENT);
+ CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ uint8_t *bytes=calloc(262161u,1u);CHECK(bytes!=NULL);
+ CHECK(gk204_inventory_bytes(bytes,262160u,&result)==GK204_SOURCE_REFUSED);
+ CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ CHECK(gk204_inventory_file("/does-not-exist.nes",&result)==GK204_SOURCE_REFUSED);
+ CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ Gk1App app;gk1_app_init(&app);
+ CHECK(gk1_app_source_selector_store_inventory(&app,"notfound",&result)==GK204_ARGUMENT);
+ CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ if(argc==2){
+  CHECK(gk204_inventory_file(argv[1],&result)==GK204_OK);
+  CHECK(result.verified_original_stock&&result.source_only_not_runtime);
+  CHECK(result.rng_selector==17u&&result.site_count==21u);
+  CHECK(result.raw_direct_store_count==9u);
+  CHECK(result.raw_direct_rmw_count==5u);
+  CHECK(result.raw_indexed_count==6u);
+  CHECK(result.raw_absolute_count==1u);
+  CHECK(result.adjacent_lda_rng_store_count==0u);
+  unsigned fixed=0,matched=0,bank10=0;
+  for(unsigned i=0;i<result.site_count;i++){
+   Gk204Site *s=&result.sites[i];
+   if(s->bank==15){
+    fixed++;
+    if(s->kind==GK204_RAW_DIRECT_STORE&&s->opcode==0x85u&&
+       s->adjacent_lda_immediate&&s->immediate_value==23u&&
+       (s->hypothetical_pc==0xef3fu||s->hypothetical_pc==0xef4du))matched++;
+   }
+   if(s->bank==10)bank10++;
+  }
+  CHECK(fixed==2u&&matched==2u&&bank10==6u);
+  baseline=result;
+  FILE *f=fopen(argv[1],"rb");CHECK(f!=NULL);
+  CHECK(fread(bytes,1,262161u,f)==262160u);CHECK(fclose(f)==0);
+  bytes[16+15*16384+0x2f3f]^=1u;
+  CHECK(gk204_inventory_bytes(bytes,262160u,&result)==GK204_SOURCE_REFUSED);
+  CHECK(memcmp(&result,&baseline,sizeof result)==0);
+  CHECK(gk204_inventory_bytes(bytes,262159u,&result)==GK204_SOURCE_REFUSED);
+  CHECK(memcmp(&result,&baseline,sizeof result)==0);
+  app.setup_stage[0]=GK53_SETUP_AWAIT_SOURCE;
+  CHECK(gk1_app_source_selector_store_inventory(&app,argv[1],&result)==GK204_OK);
+  CHECK(memcmp(&result,&baseline,sizeof result)==0);
+  CHECK(app.screen==GK1_SCREEN_TITLE&&app.stock_checkpoint.valid==0);
+  app.setup_stage[0]=GK53_SETUP_PLAYERS;
+  CHECK(gk1_app_source_selector_store_inventory(&app,argv[1],&result)==GK204_ARGUMENT);
+  CHECK(memcmp(&result,&baseline,sizeof result)==0);
+ }
+ free(bytes);printf("GK204 PASS %u assertions%s\n",checks,argc==2?" on authenticated private original":" public rejection only");
+ return 0;
+}
