new file mode 100644
index 0000000..777d0d2
--- /dev/null
+++ b/execution_173/gk173_rng_control.h
@@ -0,0 +1,23 @@
+#ifndef GK173_RNG_CONTROL_H
+#define GK173_RNG_CONTROL_H
