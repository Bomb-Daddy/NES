diff --git a/execution_173/README_EXEC0173.md b/execution_173/README_EXEC0173.md
new file mode 100644
index 0000000..27e4f72
--- /dev/null
+++ b/execution_173/README_EXEC0173.md
@@ -0,0 +1,7 @@
+# EXEC0173 — source-executed RNG transfer telemetry (partial)
+
+Preserves complete integrated EXEC0172 native 1280×720 C11 app. `gk173_rng_control.c/h` records **completed control transfers** from its existing original ROM-authenticated bounded 6502 CPU interpreter, rather than treating 986 raw `JSR $EF85` opcode-like byte patterns as executed instructions. The new `Gk83Trace.executed_rng_transfers` field counts distinct completed `JSR $EF85`, `JSR $C289`, fixed `$C1B8 JMP $C289`, other direct `JMP $C289` and indirect `JMP $C289` transfers, with bounded first/last evidence. The helper enforces input validation, overflow refusal, and no state mutation on rejection. `--source-executed-rng PRIVATE_ROM` exposes source-bounded counts from the actual compiled native game without exposing ROM bytes.
+
+**Grounded source test:** exact owner-private NES ROM SHA256 `ada7066d9e71a81310fff78bc7037126798018a69dc2b92382c3cbdcd9b243b3`. Under strict original reset with no unknown RAM invented, trace stops at `PC=$8060` due to an unknown RAM read after **70 completed instructions**. There are **zero executed RNG/dispatcher transfers before that gate**. This does **not** show that Spring uses no RNG; the remaining setup path cannot be inferred until authentic PPU/mapper and initialized RAM state reproduce original runtime. Full original-stock setup, three real Classic orders, Win32 NSIS, physical Xbox and full campaigns remain unfinished.
+
+To rebuild: `cmake -S execution_173 -B build173 -G Ninja -DCMAKE_BUILD_TYPE=Release && cmake --build build173 -j8 && ctest --test-dir build173 --output-on-failure -j8`. Private second stage: `build173/gk1_native_shell --source-executed-rng /path/to/OWNER_PRIVATE_STOCK.nes` and `build173/test_gk173_rng_control /path/to/OWNER_PRIVATE_STOCK.nes`. Never distribute ROM, Mesen state or screenshots with source or public ZIPs. Labels: VERIFIED_STATIC (authenticated identity, source interpreter), TESTED_PORT_LINUX after actual tests; OBSERVED_RUNTIME_STOCK only inherited; NOT RUN Win32/physical controller/Mesen/game campaigns.
diff --git a/execution_173/gk173_rng_control.c b/execution_173/gk173_rng_control.c
new file mode 100644
index 0000000..a343e49
--- /dev/null
+++ b/execution_173/gk173_rng_control.c
@@ -0,0 +1,34 @@
+#include "gk173_rng_control.h"
+#include <limits.h>
+Gk173Status gk173_note_completed(Gk173RngControl *out,
+ uint8_t opcode,uint16_t source_pc,uint16_t destination_pc,
+ uint8_t mapper_prg_register,uint64_t completed_cycles){
+ if(!out||(mapper_prg_register>31u&&mapper_prg_register!=0xffu))
+  return GK173_INVALID;
+ unsigned kind=0;
+ if(opcode==0x20u && destination_pc==0xef85u)kind=1u;
+ else if(opcode==0x20u && destination_pc==0xc289u)kind=2u;
+ else if(opcode==0x4cu && destination_pc==0xc289u)
+  kind=source_pc==0xc1b8u?3u:4u;
+ else if(opcode==0x6cu && destination_pc==0xc289u)kind=5u;
+ else return GK173_IGNORED;
+ if(out->total==UINT32_MAX ||
+   (kind==1u&&out->dispatch_jsr_ef85==UINT32_MAX)||
+   (kind==2u&&out->direct_jsr_c289==UINT32_MAX)||
+   (kind==3u&&out->fixed_trampoline_jmp_c289==UINT32_MAX)||
+   (kind==4u&&out->other_jmp_c289==UINT32_MAX)||
+   (kind==5u&&out->indirect_jmp_c289==UINT32_MAX))return GK173_INVALID;
+ Gk173RngControl n=*out;
+ if(!n.total){n.first_pc=source_pc;n.first_target=destination_pc;
+  n.first_opcode=opcode;n.first_prg_register=mapper_prg_register;
+  n.first_completed_cycles=completed_cycles;}
+ n.total++;n.last_pc=source_pc;n.last_target=destination_pc;
+ n.last_opcode=opcode;n.last_prg_register=mapper_prg_register;
+ n.last_completed_cycles=completed_cycles;
+ switch(kind){case 1u:n.dispatch_jsr_ef85++;break;
+  case 2u:n.direct_jsr_c289++;break;
+  case 3u:n.fixed_trampoline_jmp_c289++;break;
+  case 4u:n.other_jmp_c289++;break;
+  default:n.indirect_jmp_c289++;break;}
+ *out=n;return GK173_NOTED;
+}
