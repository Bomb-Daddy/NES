+#include "gk202_irq_rng_dispatch.h"
+#include "gk1_app_state.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static unsigned checks=0;
+#define CHECK(condition) do { \
+ checks++; \
+ if(!(condition)){ \
+  fprintf(stderr,"GK202 FAIL %s:%d %s\n",__FILE__,__LINE__,#condition); \
+  return 1; \
+ } \
+} while(0)
+static int unchanged(const Gk202Proof *x,const Gk202Proof *y){
+ return memcmp(x,y,sizeof *x)==0;
+}
+int main(int argc,char **argv){
+ Gk202Proof proof,previous;memset(&proof,0xa5,sizeof proof);previous=proof;
+ CHECK(gk202_analyze_authenticated_bytes(NULL,0,&proof)==GK202_ARGUMENT);
+ CHECK(unchanged(&proof,&previous));
+ CHECK(gk202_analyze_authenticated_file(NULL,&proof)==GK202_ARGUMENT);
+ CHECK(unchanged(&proof,&previous));
+ uint8_t *rom=(uint8_t*)calloc(GK202_STOCK_ROM_BYTES+1u,1u);
+ CHECK(rom!=NULL);
+ CHECK(gk202_analyze_authenticated_bytes(rom,GK202_STOCK_ROM_BYTES,&proof)==GK202_SOURCE_REFUSED);
+ CHECK(unchanged(&proof,&previous));
+ CHECK(gk202_analyze_authenticated_bytes(rom,GK202_STOCK_ROM_BYTES-1u,&proof)==GK202_SOURCE_REFUSED);
+ CHECK(unchanged(&proof,&previous));
+ Gk1App app;gk1_app_init(&app);
+ CHECK(gk1_app_source_irq_rng_path(&app,"unused",&proof)==GK202_ARGUMENT);
+ CHECK(unchanged(&proof,&previous));
+ /* Optional private source path is never a public CTest dependency. */
+ if(argc==2){
+  FILE *f=fopen(argv[1],"rb");CHECK(f!=NULL);
+  CHECK(fread(rom,1,GK202_STOCK_ROM_BYTES+1u,f)==GK202_STOCK_ROM_BYTES);
+  CHECK(fclose(f)==0);
+  CHECK(gk202_analyze_authenticated_bytes(rom,GK202_STOCK_ROM_BYTES,&proof)==GK202_OK);
+  CHECK(proof.irq_brk_vector==0xc14bu);
+  CHECK(proof.stack_brk_bit_mask==0x10u&&proof.stack_status_read==0x104u);
+  CHECK(proof.command_selector_ram==0x50u);
+  CHECK(proof.table_first_pc==0xc185u&&proof.table_entries==33u);
+  CHECK(proof.multiply_subroutine==0xc726u);
+  CHECK(proof.indirect_jmp_pointer==0x68u);
+  CHECK(proof.rng_slot==17u);
+  CHECK(proof.rng_entry_pc==0xc1b8u);
+  CHECK(proof.rng_target_pc==0xc289u);
+  CHECK(proof.entry_targets[17]==0xc289u);
+  CHECK(proof.entry_targets[0]==0xc000u);
+  CHECK(proof.entry_targets[32]==0xc207u);
+  CHECK(proof.direct_jsr_rng_raw_sequences==0u);
+  CHECK(proof.direct_jmp_rng_raw_sequences==1u);
+  CHECK(proof.source_only_not_runtime==1u&&proof.verified_stock_sha==1u);
+  Gk202Proof from_file={0};
+  CHECK(gk202_analyze_authenticated_file(argv[1],&from_file)==GK202_OK);
+  CHECK(unchanged(&proof,&from_file));
+  previous=proof;
+  rom[17u+15u*16384u]^=1u; /* changed PRG, valid iNES but wrong SHA */
+  CHECK(gk202_analyze_authenticated_bytes(rom,GK202_STOCK_ROM_BYTES,&proof)==GK202_SOURCE_REFUSED);
+  CHECK(unchanged(&proof,&previous));
+  rom[17u+15u*16384u]^=1u;
+  CHECK(gk202_analyze_authenticated_bytes(rom,GK202_STOCK_ROM_BYTES-1u,&proof)==GK202_SOURCE_REFUSED);
+  CHECK(unchanged(&proof,&previous));
+  /* Original setup remains gated; this source path may not unlock Spring. */
+  app.setup_stage[0]=GK53_SETUP_AWAIT_SOURCE;
+  CHECK(gk1_app_source_irq_rng_path(&app,argv[1],&from_file)==GK202_OK);
+  CHECK(app.screen==GK1_SCREEN_TITLE&&app.stock_checkpoint.valid==0);
+  CHECK(app.world_ready[0]==0&&app.world_ready[1]==0);
+  app.setup_stage[0]=GK53_SETUP_PLAYERS;
+  CHECK(gk1_app_source_irq_rng_path(&app,argv[1],&from_file)==GK202_ARGUMENT);
+ }
+ free(rom);
+ printf("GK202 PASS %u assertions%s\n",checks,argc==2?" private original ROM verified":" public negative only");
+ return 0;
+}
