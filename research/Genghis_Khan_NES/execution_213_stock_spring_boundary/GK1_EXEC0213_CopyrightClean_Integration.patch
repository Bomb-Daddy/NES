+               GK213_INCONSISTENT=3 } Gk213Status;
+typedef struct {
+ uint16_t stock_pre_food,stock_pre_gold,stock_pre_troops;
+ uint16_t stock_pre_town,stock_pre_masons,stock_pre_artisans,stock_pre_food_workers;
