+  CK(private_cases(argv[1],argv[2],GK77_FRESH_MONGOL_WORKRAM,&checks));
+  CK(private_cases(argv[1],argv[3],GK77_ARCHIVED_MONGOL_SAVERAM,&checks));
+  CK(private_cases(argv[1],argv[4],GK77_ARCHIVED_WORLD_SAVERAM,&checks));
+ }
