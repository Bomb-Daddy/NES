diff --git a/execution_199/gk205_selector_runtime_watch.c b/execution_199/gk205_selector_runtime_watch.c
new file mode 100644
index 0000000..d42fff9
--- /dev/null
+++ b/execution_199/gk205_selector_runtime_watch.c
@@ -0,0 +1,30 @@
+#include "gk205_selector_runtime_watch.h"
+#include <limits.h>
+Gk205Result gk205_note_completed_selector_store(Gk205SelectorWatch *w,
+ uint16_t pc,uint16_t addr,uint8_t value,uint8_t known,uint8_t bank,
+ uint64_t cycle){
+ if(!w||pc<0x8000u||known>1u||bank>15u)return GK205_BAD_INPUT;
+ if(addr>=0x2000u||(addr&0x07ffu)!=0x0050u)return GK205_OUTSIDE;
+ if(w->completed_selector_writes==UINT32_MAX)return GK205_BAD_INPUT;
+ if(w->completed_selector_writes>=GK205_STORED_EVENTS &&
+    w->dropped_event_details==UINT32_MAX)return GK205_BAD_INPUT;
+ Gk205Store event={pc,addr,value,bank,known,cycle};
+ if(w->completed_selector_writes<GK205_STORED_EVENTS)
+  w->first[w->completed_selector_writes]=event;
+ else w->dropped_event_details++;
+ w->completed_selector_writes++;
+ w->last=event;
+ return GK205_RECORDED;
+}
+Gk205Result gk205_note_brk_gate(Gk205SelectorWatch *w,uint16_t pc,
+ uint8_t selector_known,uint8_t selector,uint8_t bank_known,uint8_t bank){
+ if(!w||pc<0x8000u||selector_known>1u||bank_known>1u||bank>15u||
+    w->brk_gates==UINT32_MAX)return GK205_BAD_INPUT;
+ ++w->brk_gates;
+ w->brk_pc=pc;
+ w->brk_selector_known=selector_known;
+ w->brk_selector_value=selector_known?selector:0u;
+ w->brk_bank_known=bank_known;
+ w->brk_bank=bank_known?bank:0u;
+ return GK205_BRK_ATTEMPT;
+}
diff --git a/execution_199/gk205_selector_runtime_watch.h b/execution_199/gk205_selector_runtime_watch.h
new file mode 100644
index 0000000..b596534
--- /dev/null
+++ b/execution_199/gk205_selector_runtime_watch.h
@@ -0,0 +1,33 @@
+#ifndef GK205_SELECTOR_RUNTIME_WATCH_H
+#define GK205_SELECTOR_RUNTIME_WATCH_H
+#include <stdint.h>
+/* Only source-CPU stores completed in the bounded C11 6502 executor.
+ * A BRK is a GATE, not an executed interrupt, and the code never infers
+ * a first Spring, original Mesen time, or mapper state when unknown. */
+#define GK205_STORED_EVENTS 16u
+typedef enum {
+ GK205_BAD_INPUT=0,GK205_OUTSIDE=1,GK205_RECORDED=2,GK205_BRK_ATTEMPT=3
+} Gk205Result;
+typedef struct {
+ uint16_t pc, address;
+ uint8_t selector_value, prg_bank, bank_known;
+ uint64_t bus_cpu_cycle;
+} Gk205Store;
+typedef struct {
+ uint32_t completed_selector_writes;
+ uint32_t dropped_event_details;
+ uint32_t brk_gates; /* bounded emulator stopped BEFORE executing the BRK */
+ uint16_t brk_pc;
+ uint8_t brk_selector_known,brk_selector_value;
+ uint8_t brk_bank_known,brk_bank;
+ Gk205Store first[GK205_STORED_EVENTS];
+ Gk205Store last;
+} Gk205SelectorWatch;
+/* Failure/outside/overflow is atomic. NES internal RAM mirrors included.
+ * CPU cycles are a bounded interpreter's clocks, NOT original Mesen clocks. */
+Gk205Result gk205_note_completed_selector_store(Gk205SelectorWatch *w,
+ uint16_t source_pc,uint16_t cpu_addr,uint8_t value,
+ uint8_t prg_known,uint8_t prg_bank,uint64_t write_cycle);
+Gk205Result gk205_note_brk_gate(Gk205SelectorWatch *w,uint16_t source_pc,
+ uint8_t selector_known,uint8_t selector,uint8_t prg_known,uint8_t prg_bank);
+#endif
