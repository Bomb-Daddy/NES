- case 0x00:s=GK83_BRK_GATE;break;
+ case 0x00:
+  (void)gk205_note_brk_gate(&m->result.selector_runtime,start_pc,
+   m->known[0x50u],m->ram[0x50u],m->prg_known,m->prg);
+  s=GK83_BRK_GATE;break;
  default:s=GK83_OPCODE_GATE;break;
  }
