new file mode 100644
index 0000000..289722e
--- /dev/null
+++ b/README_EXEC0168.md
@@ -0,0 +1,5 @@
+# Genghis Khan I — EXEC0168 — private checkpoint safety and durability (Linux)
+
+Continues **the complete original EXEC0167** 1280×720 C11 game. This source does not create a first-Spring algorithm or unlock unverified Classic orders. The owner-private original-stock `.gk17` cold-resume path now enforces Linux file-descriptor based privacy: only regular files, mode no group/other bits, exactly one link, bounded length, no symbolic links; tests reject public, hard-linked, symlinked and malformed saves without mutating state. The reader checks permissions/identity and reads the same open file descriptor, preventing path-swap races. Owner-private saves now require flush+fsync before reporting success. Windows mode/ACL isolation is NOT RUN.
+
+Baseline EXEC0167 Linux Release 125/125 before changes. No new Mesen original runs, authentic first-Spring setup/RNG, Win32, NSIS, physical Xbox, or campaigns are claimed. Keep all original ROM and gameplay captures private.
diff --git a/gk167_private_cold_save.c b/gk167_private_cold_save.c
index ac4bbef..b054a66 100644
--- a/gk167_private_cold_save.c
+++ b/gk167_private_cold_save.c
@@ -94,7 +94,19 @@ Gk167Result gk167_save_private_new(const char *path,const Gk1App *app){
   (void)remove(path);wipe(b,sizeof b);return GK167_IO;
  }
  size_t wrote=fwrite(b,1,n,f);
- int bad=ferror(f),closed=fclose(f);
+ /* A successful save is not durable until the data has been flushed from
+  * stdio and the operating system file cache. Never report success for a
+  * partially persisted owner-private original-stock checkpoint. */
+ int bad=ferror(f);
+ if(!bad&&fflush(f)!=0)bad=1;
+ if(!bad){
+#ifdef _WIN32
+   if(_commit(fd)!=0)bad=1;
+#else
+   if(fsync(fd)!=0)bad=1;
+#endif
+ }
+ int closed=fclose(f);
  wipe(b,sizeof b);
  if(bad||closed||wrote!=n){(void)remove(path);return GK167_IO;}
  return GK167_OK;
@@ -105,7 +117,31 @@ Gk167Result gk167_cold_load_private(const char *path,const char *csv,Gk1App *app
     app->worlds[0].phase!=GK1_PRE_SETUP_TEMPLATE||
     app->worlds[1].phase!=GK1_PRE_SETUP_TEMPLATE||
     !gk1_verified_original_csv(csv))return GK167_INVALID;
- FILE *f=fopen(path,"rb");if(!f)return GK167_IO;
+ /* The payload includes private licensed original NES RAM, so refuse paths
+  * that can expose it to other users or redirect the read through a symlink.
+  * Inspection and reading use the SAME file descriptor (no TOCTOU gap).
+  * On Windows, the existing fopen path remains untested for ACL isolation. */
+ FILE *f=NULL;
+#ifndef _WIN32
+ int fd=open(path,O_RDONLY
+#ifdef O_NOFOLLOW
+    |O_NOFOLLOW
+#endif
+#ifdef O_CLOEXEC
+    |O_CLOEXEC
+#endif
+ );
+ if(fd<0)return GK167_IO;
+ struct stat st;
+ if(fstat(fd,&st)!=0||!S_ISREG(st.st_mode)||
+    (st.st_mode&077)!=0||st.st_nlink!=1||
+    st.st_size<(off_t)(GK167_HEAD+GK167_TAIL)||
+    st.st_size>(off_t)GK167_LIMIT){close(fd);return GK167_IO;}
+ f=fdopen(fd,"rb");
+ if(!f){close(fd);return GK167_IO;}
+#else
+ f=fopen(path,"rb");if(!f)return GK167_IO;
+#endif
  unsigned char b[GK167_LIMIT+1u];
  size_t n=fread(b,1,sizeof b,f);
  int bad=ferror(f),closed=fclose(f);
