+ CHECK(gk189_cold_load(path,csv,b)==GK189_CORRUPT);
+ CHECK(memcmp(snapshot,b,sizeof *b)==0);
+ CHECK(remove(path)==0);
+ free(forged);free(snapshot);free(b);free(a);
+ return 0;
