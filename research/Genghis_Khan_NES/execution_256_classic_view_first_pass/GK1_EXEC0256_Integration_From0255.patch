+ * First A only arms; B cancellation is handled by the caller's screen.
+ * The pristine checkpoint (including its original three orders) remains
+ * untouched. Do not synthesize an NES season or RNG transition here. */
+static int classic_ui_pass(Gk1App *s,Gk79Checkpoint *cp){
+ if(!s||!cp||s->rules_profile!=0u)return 0;
+ if(!s->classic_assign.active){
+  Gk187ClassicAssign next={0};
+  if(gk187_open(cp,&next)!=GK187_OK){
+   cp->pending_pass=0u;
+   strcpy(s->status,"CLASSIC PASS REFUSED: AUTHENTIC SPRING REQUIRED");return 1;
+  }
+  /* Do not activate the mutable ledger just for a cancellable prompt. */
+  if(!cp->pending_pass){
+   cp->pending_pass=1u;
+   strcpy(s->status,"PASS REMAINING CLASSIC ORDERS? A CONFIRM / B CANCEL");return 1;
+  }
+  s->classic_assign=next;
+ }
+ if(!gk187_intact(&s->classic_assign,cp)){
+  cp->pending_pass=0u;
+  strcpy(s->status,"CLASSIC PASS REFUSED: SOURCE/REPLAY CHANGED");return 1;
+ }
+ if(s->classic_assign.budget.ended||s->classic_assign.passed){
+  cp->pending_pass=0u;
+  strcpy(s->status,"CLASSIC ORDERS EXHAUSTED: NEXT NES SEASON UNIMPLEMENTED");return 1;
+ }
+ if(!cp->pending_pass){
+  cp->pending_pass=1u;
+  strcpy(s->status,"PASS REMAINING CLASSIC ORDERS? A CONFIRM / B CANCEL");return 1;
+ }
+ Gk187Result r=gk187_pass(&s->classic_assign,cp);
+ cp->pending_pass=0u;
+ strcpy(s->status,r==GK187_OK?
+   "CLASSIC MANUAL-DERIVED PASS: SEASON ENDED; NES AI/ADVANCE OPEN":
+   "CLASSIC PASS REFUSED: NO SOURCE CHANGED");return 1;
+}
