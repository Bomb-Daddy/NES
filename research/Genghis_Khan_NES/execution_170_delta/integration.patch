diff --git a/execution_170/README_EXEC0170.md b/execution_170/README_EXEC0170.md
new file mode 100644
index 0000000..61d114e
--- /dev/null
+++ b/execution_170/README_EXEC0170.md
@@ -0,0 +1,14 @@
+# GK1 EXEC0170 – Authenticated private checkpoint slot preview (research build)
+
+This incremental release continues the exact integrated EXEC0169 C11 game; it is not a new prototype. On the controller-only TITLE screen, LB/RB select one of three private original-stock slots. The screen displays a read-only preview (`VERIFIED`, `MISSING OR SECURITY-REFUSED`, or `SOURCE-INVALID`) without loading that slot into the live game. On verified slots, it displays source profile, season/year, country count and remaining orders. The preview uses the existing strict GK167 source-attested/private 0600 same-file-descriptor cold-load validator on a temporary copy of the live Gk1App; all status paths leave live state unchanged. Slot previews refresh only on selection or after save/load, not every graphical frame. Actual X/Y save/restore retains EXEC0169 behavior and no NES command or historical source state changes.
+
+No original ROM, original country SRAM, licensed assets or screenshots are included. The existing private attested source evidence is used in optional private positive tests only, not compiled in the public app. This is NOT independent original NES first-Spring generation or full campaign saving. Existing Classic original player actions remain VIEW/PASS, not three executable original NES orders.
+
+Repro from this source tree:
+
+    cmake -S execution_170 -B build170 -DCMAKE_BUILD_TYPE=Release
+    cmake --build build170 -j8
+    ctest --test-dir build170 --output-on-failure
+    cpack -G DEB --config build170/CPackConfig.cmake
+
+Validation: new `test_gk170_slot_preview` tests invalid arguments, absent slot, malformed privately owned checkpoint, insecure 0644 permissions and in-memory rollback. Optional local source-attested positive tests call with `(canonical csv, fresh WorkRAM raw, archived Mongol SaveRAM raw, archived World SaveRAM raw)`; never distribute these raw bytes. Mark fresh and archived observations separately. Linux Xvfb and extracted .deb smoke tests are port-only. Windows binary, NSIS, physical Xbox and full original campaigns are not run.
diff --git a/execution_170/gk170_slot_preview.c b/execution_170/gk170_slot_preview.c
new file mode 100644
index 0000000..fb58627
--- /dev/null
+++ b/execution_170/gk170_slot_preview.c
@@ -0,0 +1,30 @@
+#include "gk170_slot_preview.h"
+#include <stdlib.h>
+#include <string.h>
+static void scrub(void *p,size_t n){volatile unsigned char *q=p;while(n--)*q++=0;}
+Gk170SlotStatus gk170_preview_private_slot(const char *path,const char *csv,
+ const Gk1App *live,Gk170SlotPreview *out){
+ if(!path||!*path||!csv||!*csv||!live||!out)return GK170_SLOT_INVALID;
+ Gk170SlotPreview proposed={0};
+ Gk1App *copy=malloc(sizeof *copy);
+ if(!copy){proposed.status=GK170_SLOT_REFUSED;*out=proposed;return proposed.status;}
+ /* Retain the installed and unmodified canonical PRE_SETUP worlds only.
+  * The same real source verifier performs private file validation. */
+ *copy=*live;
+ Gk167Result loaded=gk167_cold_load_private(path,csv,copy);
+ if(loaded==GK167_OK){
+  const Gk79Checkpoint *cp=&copy->stock_checkpoint;
+  proposed.status=GK170_SLOT_VERIFIED;
+  proposed.profile=cp->profile;
+  proposed.country_count=cp->world.country_count;
+  proposed.player_index=cp->player_index;
+  proposed.orders_remaining=cp->orders.remaining;
+  proposed.orders_ended=cp->orders.ended;
+  proposed.year=cp->year;
+  proposed.rate=cp->rate;
+ }else{
+  proposed.status=loaded==GK167_IO?GK170_SLOT_UNAVAILABLE:GK170_SLOT_REFUSED;
+ }
+ scrub(copy,sizeof *copy);free(copy);
+ *out=proposed;return proposed.status;
+}
diff --git a/execution_170/gk170_slot_preview.h b/execution_170/gk170_slot_preview.h
new file mode 100644
index 0000000..fb5b5ee
--- /dev/null
+++ b/execution_170/gk170_slot_preview.h
@@ -0,0 +1,25 @@
+#ifndef GK170_SLOT_PREVIEW_H
+#define GK170_SLOT_PREVIEW_H
+#include "gk167_private_cold_save.h"
+/* PORT-ONLY, owner-private checkpoint inventory for controller TITLE screen.
+ * Preview uses the SAME source-attested, owner-private cold-load validator as
+ * actual Y-restore; never trusts the header, does not expose country RAM,
+ * and never changes the live game, turns, country fields, or saved files.
+ * This is a saved ORIGINAL spring continuation, NOT a playable NES season.
+ */
+typedef enum {
+ GK170_SLOT_INVALID=0, GK170_SLOT_UNAVAILABLE=1,
+ GK170_SLOT_REFUSED=2, GK170_SLOT_VERIFIED=3
+} Gk170SlotStatus;
+typedef struct {
+ Gk170SlotStatus status;
+ uint8_t profile,country_count,player_index,orders_remaining,orders_ended;
+ uint16_t year,rate;
+} Gk170SlotPreview;
+/* Requires canonical CSV and already-installed verified PRE_SETUP worlds.
+ * One file per call, only on slot selection/title entry (not on every frame).
+ * On argument failure output untouched. On file failure returns a neutral
+ * status with zero numeric fields. */
+Gk170SlotStatus gk170_preview_private_slot(const char *path,const char *csv,
+ const Gk1App *live,Gk170SlotPreview *out);
+#endif
