+/* Unlike a byte-pattern search, record only instructions reached by the
+ * existing bounded RESET/NMI/IRQ static decoder. A branch is not evidence of
+ * execution, and caller-selected MMC1 banks remain explicit hypotheses. */
+static int insert_rng_call(Gk181Map *r,uint16_t pc,uint8_t bank,uint8_t root){
+ for(uint16_t i=0;i<r->rng_call_count;i++){
+  Gk181RngCall *s=&r->rng_calls[i];
+  if(s->pc==pc&&s->bank==bank){s->roots|=(uint8_t)(1u<<root);return 1;}
+ }
+ if(r->rng_call_count==GK181_MAX_RNG_CALLS)return 0;
+ Gk181RngCall *s=&r->rng_calls[r->rng_call_count++];
+ s->pc=pc;s->bank=bank;s->roots=(uint8_t)(1u<<root);
+ if(bank==15u)r->fixed_rng_call_count++;
+ else r->low_rng_call_count++;
+ return 1;
+}
